<%- include('layout/header', { title: 'Просмотр записей о коровах' }) %>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-list-check"></i> Записи о выбытии коров</h4>
            </div>
            <div class="card-body">
                <!-- Фильтры -->
                <div class="row mb-4">
                    <div class="col-md-12">
                        <h5><i class="bi bi-funnel"></i> Фильтры и сортировка</h5>
                        <div class="row g-3">
                            <% if (user_type === 'admin') { %>
                            <div class="col-md-3">
                                <label class="form-label">Ферма</label>
                                <select class="form-select" id="farm_filter">
                                    <option value="">Все фермы</option>
                                </select>
                            </div>
                            <% } else { %>
                            <div class="col-md-3">
                                <label class="form-label">Ферма</label>
                                <input type="text" class="form-control" value="<%= session.farm_name %>" disabled>
                            </div>
                            <% } %>
                            
                            <div class="col-md-3">
                                <label class="form-label">Категория</label>
                                <select class="form-select" id="category_filter">
                                    <option value="">Все категории</option>
                                    <option value="падёж">Падёж</option>
                                    <option value="выбраковка">Выбраковка</option>
                                    <option value="санитарный">Санитарный</option>
                                </select>
                            </div>
                            
                            <div class="col-md-3">
                                <label class="form-label">Причина</label>
                                <select class="form-select" id="reason_filter" disabled>
                                    <option value="">Все причины</option>
                                </select>
                            </div>
                            
                            <div class="col-md-3">
                                <label class="form-label">Сортировка по дате</label>
                                <select class="form-select" id="date_sort">
                                    <option value="newest">Самые новые сначала</option>
                                    <option value="oldest">Самые старые сначала</option>
                                </select>
                            </div>
                            
                            <div class="col-md-12">
                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button type="button" id="reset_filters" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle"></i> Сбросить фильтры
                                    </button>
                                    <button type="button" id="apply_filters" class="btn btn-primary">
                                        <i class="bi bi-funnel"></i> Применить фильтры
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Быстрый поиск -->
                <div class="mb-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Быстрый поиск по всем полям...">
                    </div>
                </div>
                
                <% if (cows && cows.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover" id="cowsTable">
                        <thead>
                            <tr>
                                <th>ID коровы</th>
                                <th>Ферма</th>
                                <th>Категория</th>
                                <th>Причина</th>
                                <th>Дата выбытия</th>
                                <th>Дата добавления</th>
                                <% if (user_type !== 'admin') { %>
                                <th>Действия</th>
                                <% } %>
                            </tr>
                        </thead>
                        <tbody>
                            <% cows.forEach(function(cow) { %>
                            <tr>
                                <td><strong><%= cow.cow_id %></strong></td>
                                <td><%= cow.farm_name %></td>
                                <td>
                                    <% if (cow.category === 'падёж') { %>
                                        <span class="badge bg-danger">Падёж</span>
                                    <% } else if (cow.category === 'выбраковка') { %>
                                        <span class="badge bg-warning text-dark">Выбраковка</span>
                                    <% } else { %>
                                        <span class="badge bg-info">Санитарный</span>
                                    <% } %>
                                </td>
                                <td><%= cow.reason %></td>
                                <td><%= cow.disposal_date %></td>
                                <td><%= cow.created_at %></td>
                                <% if (user_type !== 'admin') { %>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm delete-cow-btn" 
                                            data-cow-id="<%= cow.id %>" 
                                            data-cow-number="<%= cow.cow_id %>">
                                        <i class="bi bi-trash"></i> Удалить
                                    </button>
                                </td>
                                <% } %>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle"></i> Всего записей: <%= cows.length %> | 
                    Отображено: <span id="row_count"><%= cows.length %></span>
                    <% if (user_type === 'admin') { %>
                    | Ферм в системе: <%= [...new Set(cows.map(c => c.farm_name))].length %>
                    <% } %>
                </div>
                <% } else { %>
                <div class="text-center py-5">
                    <i class="bi bi-database" style="font-size: 3rem; color: #6c757d;"></i>
                    <h4 class="mt-3">Нет данных</h4>
                    <p>Записи о выбытии скота ещё не добавлены.</p>
                    <% if (user_type !== 'admin') { %>
                    <p class="text-muted">Для добавления записей используйте раздел "Добавить коровы".</p>
                    <% } %>
                </div>
                <% } %>
            </div>
        </div>
        
        <!-- Статистика -->
        <% if (cows && cows.length > 0) { %>
        <div class="card mt-3">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Статистика по данным</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <h3><%= cows.length %></h3>
                                <p class="text-muted">Всего записей</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <h3><%= cows.filter(c => c.category === 'падёж').length %></h3>
                                <p class="text-muted">Падёж</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <h3><%= cows.filter(c => c.category === 'выбраковка').length %></h3>
                                <p class="text-muted">Выбраковка</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </div>
</div>

<%- include('layout/footer', {
    extra_js: `
    <script>
    $(document).ready(function() {
        ${user_type === 'admin' ? `
        $.getJSON('/get_farms', function(data) {
            var $farmSelect = $('#farm_filter');
            $farmSelect.empty();
            $farmSelect.append('<option value="">Все фермы</option>');
            $.each(data, function(index, farm) {
                $farmSelect.append('<option value="' + farm + '">' + farm + '</option>');
            });
        });
        ` : ''}
        
        $('#category_filter').change(function() {
            var category = $(this).val();
            var $reasonSelect = $('#reason_filter');
            
            if (category) {
                $.getJSON('/get_reasons/' + encodeURIComponent(category), function(data) {
                    $reasonSelect.empty();
                    $reasonSelect.append('<option value="">Все причины</option>');
                    $.each(data, function(index, reason) {
                        $reasonSelect.append('<option value="' + reason + '">' + reason + '</option>');
                    });
                    $reasonSelect.prop('disabled', false);
                });
            } else {
                $reasonSelect.empty();
                $reasonSelect.append('<option value="">Все причины</option>');
                $reasonSelect.prop('disabled', true);
            }
        });
        
        $('#apply_filters').click(function() {
            var farm_filter = $('#farm_filter').val() || '';
            var category_filter = $('#category_filter').val() || '';
            var reason_filter = $('#reason_filter').val() || '';
            var date_sort = $('#date_sort').val() || 'newest';
            
            $('#cowsTable tbody tr').each(function() {
                var showRow = true;
                var farm_cell = $(this).find('td:eq(1)').text().trim();
                var category_cell = $(this).find('td:eq(2) span').text().trim().toLowerCase();
                var reason_cell = $(this).find('td:eq(3)').text().trim();
                
                if (farm_filter && farm_cell !== farm_filter) {
                    showRow = false;
                }
                
                if (category_filter && category_cell !== category_filter) {
                    showRow = false;
                }
                
                if (reason_filter && reason_cell !== reason_filter) {
                    showRow = false;
                }
                
                $(this).toggle(showRow);
            });
            
            if (date_sort) {
                var rows = $('#cowsTable tbody tr').toArray();
                rows.sort(function(a, b) {
                    var dateA = $(a).find('td:eq(4)').text();
                    var dateB = $(b).find('td:eq(4)').text();
                    return date_sort === 'newest' ? dateB.localeCompare(dateA) : dateA.localeCompare(dateB);
                });
                $('#cowsTable tbody').empty().append(rows);
            }
            updateRowCount();
        });
        
        $('#reset_filters').click(function() {
            $('#farm_filter').val('');
            $('#category_filter').val('');
            $('#reason_filter').val('').prop('disabled', true);
            $('#date_sort').val('newest');
            $('#cowsTable tbody tr').show();
            updateRowCount();
        });
        
        function updateRowCount() {
            var visibleRows = $('#cowsTable tbody tr:visible').length;
            $('#row_count').text(visibleRows);
        }
        
        $('#searchInput').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('#cowsTable tbody tr').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
            updateRowCount();
        });
        
        $(document).on('click', '.delete-cow-btn', function() {
            var cowId = $(this).data('cow-id');
            var cowNumber = $(this).data('cow-number');
            
            if (confirm('Вы уверены, что хотите удалить запись о корове с ID ' + cowNumber + '?')) {
                var $btn = $(this);
                $btn.html('<i class="bi bi-hourglass-split"></i> Удаление...').prop('disabled', true);
                
                $.ajax({
                    url: '/delete_cow/' + cowId,
                    type: 'POST',
                    success: function() {
                        window.location.reload();
                    },
                    error: function(xhr, status, error) {
                        alert('Ошибка при удалении записи: ' + error);
                        $btn.html('<i class="bi bi-trash"></i> Удалить').prop('disabled', false);
                    }
                });
            }
        });
    });
    </script>
    `
}) %>
