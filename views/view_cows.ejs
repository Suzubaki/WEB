<%- include('layout/header', { title: 'Просмотр записей о коровах' }) %>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-list-check"></i> Записи о выбытии коров</h4>
            </div>
            <div class="card-body">
                <!-- Фильтры -->
                <div class="row mb-4">
                    <div class="col-md-12">
                        <h5><i class="bi bi-funnel"></i> Фильтры и сортировка</h5>
                        <div class="row g-3">
                            <% if (user_type === 'admin') { %>
                            <div class="col-md-3">
                                <label class="form-label">Ферма</label>
                                <select class="form-select" id="farm_filter">
                                    <option value="">Все фермы</option>
                                </select>
                            </div>
                            <% } else { %>
                            <div class="col-md-3">
                                <label class="form-label">Ферма</label>
                                <input type="text" class="form-control" value="<%= session.farm_name %>" disabled>
                            </div>
                            <% } %>
                            
                            <div class="col-md-3">
                                <label class="form-label">Категория</label>
                                <select class="form-select" id="category_filter">
                                    <option value="">Все категории</option>
                                    <option value="падёж">Падёж</option>
                                    <option value="выбраковка">Выбраковка</option>
                                    <option value="санитарный">Санитарный брак</option>
                                </select>
                            </div>
                            
                            <div class="col-md-3">
                                <label class="form-label">Причина</label>
                                <select class="form-select" id="reason_filter" disabled>
                                    <option value="">Все причины</option>
                                </select>
                            </div>
                            
                            <div class="col-md-3">
                                <label class="form-label">Сортировка по дате</label>
                                <select class="form-select" id="date_sort">
                                    <option value="newest">Самые новые сначала</option>
                                    <option value="oldest">Самые старые сначала</option>
                                </select>
                            </div>
                            
                            <div class="col-md-12">
                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button type="button" id="reset_filters" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle"></i> Сбросить фильтры
                                    </button>
                                    <button type="button" id="apply_filters" class="btn btn-primary">
                                        <i class="bi bi-funnel"></i> Применить фильтры
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Баннер наличия данных -->
                <div class="alert alert-success d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 py-2 px-3">
                    <div>
                        <i class="bi bi-check2-circle me-2 fs-5 text-success"></i>
                        <strong>В базе данных активно: <%= cows.length %> записей о выбытии КРС</strong> за последние 12 месяцев.
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/dashboard" class="btn btn-sm btn-success"><i class="bi bi-speedometer2"></i> На дашборд</a>
                        <a href="/admin/generator" class="btn btn-sm btn-outline-success"><i class="bi bi-cpu"></i> Управление базой</a>
                    </div>
                </div>

                <!-- Быстрый поиск и управление пагинацией -->
                <div class="row align-items-center g-2 mb-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="searchInput" class="form-control" placeholder="Быстрый поиск: номер, бирка, ферма, диагноз...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-layout-text-window"></i> Строк:</span>
                            <select class="form-select" id="pageSizeSelect">
                                <option value="50" selected>50 строк</option>
                                <option value="100">100 строк</option>
                                <option value="250">250 строк</option>
                                <option value="all">Все <%= cows.length %> строк</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <span class="badge bg-primary fs-6 p-2"><i class="bi bi-database"></i> Всего: <%= cows.length %> гол.</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small" id="pageInfoText">Загрузка данных...</span>
                    <nav aria-label="Пагинация сверху">
                        <ul class="pagination pagination-sm mb-0" id="paginationTop"></ul>
                    </nav>
                </div>
                
                <% if (cows && cows.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle" id="cowsTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID выбытия</th>
                                <th>Бирка AITS</th>
                                <th>Ферма (МТФ)</th>
                                <th>Категория</th>
                                <th>Причина / Диагноз</th>
                                <th>Возрастная группа</th>
                                <th>Масса (кг)</th>
                                <th>Дата выбытия</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% cows.forEach(function(cow) { %>
                            <tr class="cow-row" 
                                data-farm="<%= cow.farm_name %>" 
                                data-category="<%= cow.category %>" 
                                data-reason="<%= cow.reason %>" 
                                data-date="<%= cow.disposal_date %>">
                                <td><strong class="text-primary font-monospace"><%= cow.cow_id %></strong></td>
                                <td>
                                    <% if (cow.ear_tag) { %>
                                        <span class="badge bg-secondary font-monospace"><%= cow.ear_tag %></span>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td><i class="bi bi-building"></i> <%= cow.farm_name %></td>
                                <td>
                                    <% if (cow.category === 'падёж') { %>
                                        <span class="badge bg-danger">Падёж</span>
                                    <% } else if (cow.category === 'выбраковка') { %>
                                        <span class="badge bg-primary">Выбраковка</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">Санитарный брак</span>
                                    <% } %>
                                </td>
                                <td class="fw-semibold"><%= cow.reason %></td>
                                <td><small class="text-muted"><%= cow.age_group || 'Коровы дойного стада' %></small></td>
                                <td><%= cow.weight ? cow.weight + ' кг' : '-' %></td>
                                <td><span class="badge bg-light text-dark border"><%= cow.disposal_date %></span></td>
                                <td class="text-end text-nowrap">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <% if (cow.category === 'падёж') { %>
                                        <a href="/autopsy/<%= cow.id %>" class="btn btn-outline-danger btn-sm" title="Протокол вскрытия трупа (патологоанатомический)">
                                            <i class="bi bi-file-medical-fill"></i> Вскрытие
                                        </a>
                                        <% } %>
                                        <a href="/edit_cow/<%= cow.id %>" class="btn btn-outline-primary btn-sm" title="Редактировать">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <% if (user_type !== 'admin') { %>
                                        <button type="button" class="btn btn-outline-danger btn-sm delete-cow-btn" 
                                                data-cow-id="<%= cow.id %>" 
                                                data-cow-number="<%= cow.cow_id %>"
                                                title="Удалить запись">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <!-- Нижняя панель пагинации -->
                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="alert alert-info py-2 px-3 mb-0 small">
                        <i class="bi bi-info-circle"></i> Всего в базе: <strong><%= cows.length %></strong> | 
                        Найдено по фильтрам: <strong id="row_count"><%= cows.length %></strong>
                        <% if (user_type === 'admin') { %>
                        | Ферм: <strong><%= [...new Set(cows.map(c => c.farm_name))].length %></strong>
                        <% } %>
                    </div>
                    <nav aria-label="Пагинация снизу">
                        <ul class="pagination pagination-sm mb-0" id="paginationBottom"></ul>
                    </nav>
                </div>
                <% } else { %>
                <div class="text-center py-5">
                    <i class="bi bi-database" style="font-size: 3rem; color: #6c757d;"></i>
                    <h4 class="mt-3">Нет данных</h4>
                    <p>Записи о выбытии скота ещё не добавлены.</p>
                    <a href="/admin/generator" class="btn btn-primary"><i class="bi bi-cpu"></i> Сгенерировать тестовые данные</a>
                </div>
                <% } %>
            </div>
        </div>
        
        <!-- Статистика -->
        <% if (cows && cows.length > 0) { %>
        <div class="card mt-3">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Статистика по данным</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <h3><%= cows.length %></h3>
                                <p class="text-muted">Всего записей</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <h3><%= cows.filter(c => c.category === 'падёж').length %></h3>
                                <p class="text-muted">Падёж</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <h3><%= cows.filter(c => c.category === 'выбраковка').length %></h3>
                                <p class="text-muted">Выбраковка</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </div>
</div>

<%- include('layout/footer', {
    extra_js: `
    <script>
    (function() {
        function initCowsPage() {
            var cowsTable = document.getElementById('cowsTable');
            if (!cowsTable) return;

            var allRows = Array.from(cowsTable.querySelectorAll('tbody tr.cow-row'));
            var filteredRows = allRows.slice();
            var currentPage = 1;
            var pageSizeSelect = document.getElementById('pageSizeSelect');
            var pageSize = pageSizeSelect ? pageSizeSelect.value : 50;

            var farmFilter = document.getElementById('farm_filter');
            var categoryFilter = document.getElementById('category_filter');
            var reasonFilter = document.getElementById('reason_filter');
            var dateSort = document.getElementById('date_sort');
            var searchInput = document.getElementById('searchInput');

            var rowCountSpan = document.getElementById('row_count');
            var pageInfoText = document.getElementById('pageInfoText');
            var paginationTop = document.getElementById('paginationTop');
            var paginationBottom = document.getElementById('paginationBottom');

            // Заполнение списка ферм
            if (farmFilter && farmFilter.tagName === 'SELECT') {
                fetch('/get_farms')
                    .then(function(r) { return r.json(); })
                    .then(function(farms) {
                        farms.forEach(function(f) {
                            var opt = document.createElement('option');
                            opt.value = f;
                            opt.textContent = f;
                            farmFilter.appendChild(opt);
                        });
                    })
                    .catch(function(e) { console.error(e); });
            }

            // Выбор категории -> причины
            if (categoryFilter && reasonFilter) {
                categoryFilter.addEventListener('change', function() {
                    var cat = this.value;
                    reasonFilter.innerHTML = '<option value="">Все причины</option>';
                    if (cat) {
                        fetch('/get_reasons/' + encodeURIComponent(cat))
                            .then(function(r) { return r.json(); })
                            .then(function(reasons) {
                                reasons.forEach(function(r) {
                                    var opt = document.createElement('option');
                                    opt.value = r;
                                    opt.textContent = r;
                                    reasonFilter.appendChild(opt);
                                });
                                reasonFilter.disabled = false;
                            });
                    } else {
                        reasonFilter.disabled = true;
                    }
                    applyAllFilters();
                });
            }

            function applyAllFilters() {
                var fVal = farmFilter ? (farmFilter.value || '') : '';
                var cVal = categoryFilter ? (categoryFilter.value || '').toLowerCase() : '';
                var rVal = reasonFilter ? (reasonFilter.value || '') : '';
                var sVal = searchInput ? (searchInput.value || '').toLowerCase().trim() : '';
                var sSort = dateSort ? (dateSort.value || 'newest') : 'newest';

                filteredRows = allRows.filter(function(row) {
                    var farm_cell = row.getAttribute('data-farm') || '';
                    var cat_cell = (row.getAttribute('data-category') || '').toLowerCase();
                    var reason_cell = row.getAttribute('data-reason') || '';
                    var fullText = row.textContent.toLowerCase();

                    if (fVal && farm_cell !== fVal) return false;
                    if (cVal) {
                        var isSanitary = (cVal === 'санитарный' || cVal === 'санбрак') && (cat_cell.includes('сан') || cat_cell.includes('санитар'));
                        if (cat_cell !== cVal && !isSanitary) return false;
                    }
                    if (rVal && reason_cell !== rVal) return false;
                    if (sVal && fullText.indexOf(sVal) === -1) return false;

                    return true;
                });

                // Сортировка
                filteredRows.sort(function(a, b) {
                    var dateA = a.getAttribute('data-date') || '';
                    var dateB = b.getAttribute('data-date') || '';
                    return sSort === 'newest' ? dateB.localeCompare(dateA) : dateA.localeCompare(dateB);
                });

                currentPage = 1;
                renderPagination();
            }

            function renderPagination() {
                var total = filteredRows.length;
                if (rowCountSpan) rowCountSpan.textContent = total;

                allRows.forEach(function(r) { r.style.display = 'none'; });

                if (total === 0) {
                    if (pageInfoText) pageInfoText.textContent = 'Записи не найдены';
                    if (paginationTop) paginationTop.innerHTML = '';
                    if (paginationBottom) paginationBottom.innerHTML = '';
                    return;
                }

                var effSize = pageSize === 'all' ? total : parseInt(pageSize, 10);
                var totalPages = Math.ceil(total / effSize);
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                var startIndex = (currentPage - 1) * effSize;
                var endIndex = Math.min(startIndex + effSize, total);

                for (var i = startIndex; i < endIndex; i++) {
                    filteredRows[i].style.display = '';
                }

                if (pageInfoText) {
                    pageInfoText.innerHTML = 'Показано <strong>' + (startIndex + 1) + '–' + endIndex + '</strong> из <strong>' + total + '</strong> записей ' +
                        '(Страница ' + currentPage + ' из ' + totalPages + ')';
                }

                var pagHtml = '';
                if (totalPages > 1) {
                    pagHtml += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">';
                    pagHtml += '<a class="page-link" href="#" data-page="' + (currentPage - 1) + '">&laquo;</a></li>';

                    var startPage = Math.max(1, currentPage - 2);
                    var endPage = Math.min(totalPages, currentPage + 2);

                    if (startPage > 1) {
                        pagHtml += '<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>';
                        if (startPage > 2) pagHtml += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                    }

                    for (var p = startPage; p <= endPage; p++) {
                        pagHtml += '<li class="page-item ' + (p === currentPage ? 'active' : '') + '">';
                        pagHtml += '<a class="page-link" href="#" data-page="' + p + '">' + p + '</a></li>';
                    }

                    if (endPage < totalPages) {
                        if (endPage < totalPages - 1) pagHtml += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                        pagHtml += '<li class="page-item"><a class="page-link" href="#" data-page="' + totalPages + '">' + totalPages + '</a></li>';
                    }

                    pagHtml += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '">';
                    pagHtml += '<a class="page-link" href="#" data-page="' + (currentPage + 1) + '">&raquo;</a></li>';
                }

                if (paginationTop) paginationTop.innerHTML = pagHtml;
                if (paginationBottom) paginationBottom.innerHTML = pagHtml;
            }

            document.addEventListener('click', function(e) {
                var target = e.target.closest('.page-link');
                if (target && target.getAttribute('data-page')) {
                    e.preventDefault();
                    var p = parseInt(target.getAttribute('data-page'), 10);
                    if (!isNaN(p)) {
                        currentPage = p;
                        renderPagination();
                        var tbl = document.getElementById('cowsTable');
                        if (tbl) window.scrollTo({ top: tbl.getBoundingClientRect().top + window.pageYOffset - 120, behavior: 'smooth' });
                    }
                }
            });

            if (pageSizeSelect) {
                pageSizeSelect.addEventListener('change', function() {
                    pageSize = this.value;
                    currentPage = 1;
                    renderPagination();
                });
            }

            var applyBtn = document.getElementById('apply_filters');
            if (applyBtn) applyBtn.addEventListener('click', applyAllFilters);

            var resetBtn = document.getElementById('reset_filters');
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    if (farmFilter && farmFilter.tagName === 'SELECT') farmFilter.value = '';
                    if (categoryFilter) categoryFilter.value = '';
                    if (reasonFilter) { reasonFilter.value = ''; reasonFilter.disabled = true; }
                    if (dateSort) dateSort.value = 'newest';
                    if (searchInput) searchInput.value = '';
                    applyAllFilters();
                });
            }

            var searchTimer = null;
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(applyAllFilters, 150);
                });
            }

            [farmFilter, categoryFilter, reasonFilter, dateSort].forEach(function(el) {
                if (el) el.addEventListener('change', applyAllFilters);
            });

            // Инициализация
            applyAllFilters();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCowsPage);
        } else {
            initCowsPage();
        }
    })();
    </script>
    `
}) %>
