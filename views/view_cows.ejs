<%- include('layout/header', { title: 'Просмотр записей о коровах' }) %>

<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h4 class="mb-0"><i class="bi bi-list-check"></i> Записи о выбытии коров</h4>
                <span class="badge bg-light text-dark fs-6" id="headerCountBadge">
                    <i class="bi bi-database-check"></i> Всего в базе: <%= total_cows_count %> гол.
                </span>
            </div>
            <div class="card-body">
                <!-- Переключатель категорий учета: Живой скот / Мертворождения / Все -->
                <div class="d-flex flex-wrap gap-2 mb-3" id="recordTypeTabGroup">
                    <button type="button" class="btn btn-primary rounded-pill px-3 py-2 fw-bold record-tab-btn active" data-record-type="live">
                        🐄 Выбытие живого скота (Падёж / Выбраковка / Санбрак)
                    </button>
                    <button type="button" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-bold record-tab-btn" data-record-type="stillborn">
                        ❌ Мертворождения и аборты (Потери приплода)
                    </button>
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-bold record-tab-btn" data-record-type="all">
                        📋 Сводный журнал (Все записи)
                    </button>
                </div>

                <!-- Панель быстрых фильтров -->
                <div class="bg-light p-3 rounded-3 mb-4 border">
                    <h5 class="mb-3 text-secondary d-flex align-items-center gap-2">
                        <i class="bi bi-funnel-fill text-primary"></i> Быстрые фильтры и сортировка
                    </h5>
                    <div class="row g-3">
                        <% if (user_type === 'admin') { %>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Ферма (МТФ)</label>
                            <select class="form-select" id="farm_filter">
                                <option value="">Все фермы (Свод)</option>
                                <% (unique_farms || []).forEach(function(f) { %>
                                <option value="<%= f %>"><%= f %></option>
                                <% }); %>
                            </select>
                        </div>
                        <% } else { %>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Ферма (МТФ)</label>
                            <input type="text" class="form-control" value="<%= session.farm_name %>" disabled>
                        </div>
                        <% } %>
                        
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Категория выбытия</label>
                            <select class="form-select" id="category_filter">
                                <option value="">Все категории</option>
                                <option value="падёж">Падёж</option>
                                <option value="выбраковка">Выбраковка</option>
                                <option value="санитарный">Санитарный брак</option>
                            </select>
                        </div>
                        
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Причина / Диагноз</label>
                            <select class="form-select" id="reason_filter" disabled>
                                <option value="">Все причины</option>
                            </select>
                        </div>
                        
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Сортировка</label>
                            <select class="form-select" id="date_sort">
                                <option value="newest" selected>Самые новые сначала</option>
                                <option value="oldest">Самые старые сначала</option>
                                <option value="weight_desc">По живой массе (убыв.)</option>
                                <option value="id_desc">По номеру ID (убыв.)</option>
                                <option value="id_asc">По номеру ID (возр.)</option>
                            </select>
                        </div>

                        <!-- Новые зоотехнические фильтры: Категория поголовья и Дни лактации -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-success">
                                <i class="bi bi-diagram-3-fill"></i> Категория скота (Половозрастная группа)
                            </label>
                            <select class="form-select border-success-subtle" id="age_group_filter">
                                <option value="">Все категории и возрасты</option>
                                <option value="Телята (до 6 мес.)">🍼 Телята (до 6 мес.)</option>
                                <option value="Молодняк (от 6 до 18 мес.)">🌱 Ремонтный молодняк (6–18 мес.)</option>
                                <option value="Нетели и тёлки (> 18 мес.)">🤰 Нетели и тёлки (> 18 мес.)</option>
                                <option value="Новотельные коровы (0–30 дн DIM)">⚡ Выбытие новотельных (0–30 дн DIM)</option>
                                <option value="Коровы 1-й лактации (первотёлки)">⭐ Коровы 1-й лактации (первотёлки)</option>
                                <option value="Коровы 2+ лактаций (полновозрастные)">🥛 Коровы 2+ лактаций (полновозрастные)</option>
                                <option value="Коровы сухостойные">💤 Коровы сухостойные</option>
                                <option value="Бычки на откорме">🐂 Бычки на откорме</option>
                                <option value="Мертворождённые / Аборты">❌ Мертворождённые / Аборты (внутриутробные потери)</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-primary">
                                <i class="bi bi-clock-history"></i> Фаза лактации / DIM
                            </label>
                            <select class="form-select border-primary-subtle" id="lactation_phase_filter">
                                <option value="">Все стадии лактации</option>
                                <option value="Новотел">⚡ Новотел (0–30 дн. DIM)</option>
                                <option value="Раздой">📈 Раздой (31–100 дн. DIM)</option>
                                <option value="Середина">⚖️ Середина (101–200 дн. DIM)</option>
                                <option value="Спад">📉 Спад лактации (201–305+ дн. DIM)</option>
                                <option value="Сухостой">💤 Сухостой</option>
                                <option value="Молодняк">👶 Молодняк</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-danger">
                                <i class="bi bi-heart-pulse-fill"></i> Выбытие стельных / Аборты
                            </label>
                            <select class="form-select border-danger-subtle fw-semibold" id="repro_filter">
                                <option value="">Все статусы</option>
                                <option value="pregnant" <%= (typeof repro_filter !== 'undefined' && repro_filter === 'pregnant') ? 'selected' : '' %>>⚠️ Только выбытие стельных</option>
                                <option value="pregnant_late" <%= (typeof repro_filter !== 'undefined' && repro_filter === 'pregnant_late') ? 'selected' : '' %>>🤰 Глубокостельные (180+ дн.)</option>
                                <option value="stillborn" <%= (typeof repro_filter !== 'undefined' && repro_filter === 'stillborn') ? 'selected' : '' %>>❌ Мертворождённые / Аборты</option>
                            </select>
                        </div>
                        
                        <div class="col-md-12">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2 border-top">
                                <small class="text-muted">
                                    <i class="bi bi-lightning-charge-fill text-warning"></i>
                                    Зоотехническая аналитика: фильтрация по дням лактации (DIM), группам риска и молодняку.
                                </small>
                                <div class="d-flex gap-2">
                                    <button type="button" id="reset_filters" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-x-circle"></i> Сбросить фильтры
                                    </button>
                                    <button type="button" id="apply_filters" class="btn btn-primary btn-sm">
                                        <i class="bi bi-funnel"></i> Применить
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Баннер наличия данных -->
                <div class="alert alert-success d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 py-2 px-3 shadow-sm">
                    <div>
                        <i class="bi bi-check2-circle me-2 fs-5 text-success"></i>
                        <strong>В базе данных активно: <span id="bannerTotalCount"><%= total_cows_count %></span> записей о выбытии КРС</strong>.
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/dashboard" class="btn btn-sm btn-success"><i class="bi bi-speedometer2"></i> Дашборд</a>
                        <a href="/admin/generator" class="btn btn-sm btn-outline-success"><i class="bi bi-cpu"></i> Управление базой (Стресс-тест)</a>
                    </div>
                </div>

                <!-- Быстрый поиск и управление пагинацией -->
                <div class="row align-items-center g-2 mb-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                            <input type="text" id="searchInput" class="form-control" placeholder="Мгновенный поиск: номер, бирка AITS, диагноз, категория, DIM...">
                            <button class="btn btn-outline-secondary" type="button" id="clearSearchBtn" title="Очистить поиск" style="display: none;">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-layout-text-window"></i> Строк:</span>
                            <select class="form-select" id="pageSizeSelect">
                                <option value="25">25 строк</option>
                                <option value="50" selected>50 строк</option>
                                <option value="100">100 строк</option>
                                <option value="250">250 строк</option>
                                <option value="500">500 строк</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <span class="badge bg-primary fs-6 p-2" id="filteredBadge">
                            <i class="bi bi-funnel"></i> Найдено: <span id="badgeFilteredCount"><%= total_cows_count %></span> гол.
                        </span>
                    </div>
                </div>

                <!-- Верхняя строка пагинации и инфо -->
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small" id="pageInfoText">
                            Показано <strong>1–<%= Math.min(50, total_cows_count) %></strong> из <strong><%= total_cows_count %></strong> записей
                        </span>
                        <div class="spinner-border spinner-border-sm text-primary" id="tableSpinner" role="status" style="display: none;">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                    </div>
                    <nav aria-label="Пагинация сверху">
                        <ul class="pagination pagination-sm mb-0" id="paginationTop"></ul>
                    </nav>
                </div>
                
                <!-- Таблица записей -->
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle" id="cowsTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID выбытия</th>
                                <th>Бирка AITS</th>
                                <th>Ферма (МТФ)</th>
                                <th>Категория</th>
                                <th>Причина / Диагноз</th>
                                <th>Категория скота</th>
                                <th>Лактация & DIM</th>
                                <th>Масса (кг)</th>
                                <th>Дата выбытия</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody id="cowsTableBody">
                            <% if (cows && cows.length > 0) { %>
                                <% cows.forEach(function(cow) { %>
                                <tr class="cow-row" data-id="<%= cow.id %>">
                                    <td><strong class="text-primary font-monospace"><%= cow.cow_id %></strong></td>
                                    <td>
                                        <% if (cow.ear_tag) { %>
                                            <span class="badge bg-secondary font-monospace"><%= cow.ear_tag %></span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td><i class="bi bi-building"></i> <%= cow.farm_name %></td>
                                    <td>
                                        <% if (cow.category === 'падёж') { %>
                                            <span class="badge bg-danger">Падёж</span>
                                        <% } else if (cow.category === 'выбраковка') { %>
                                            <span class="badge bg-primary">Выбраковка</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark">Санитарный брак</span>
                                        <% } %>
                                    </td>
                                    <td class="fw-semibold">
                                        <%= cow.reason %>
                                        <% if (cow.is_pregnant === 1) { %>
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle ms-1" title="Срок стельности: <%= cow.gestation_days || 0 %> дн."><i class="bi bi-suit-heart-fill text-danger"></i> Стельная</span>
                                        <% } %>
                                        <% if (cow.is_stillborn === 1) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1"><i class="bi bi-x-circle-fill"></i> Мертворожд./Аборт</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% var grp = cow.age_group || 'Коровы 2+ лактаций (полновозрастные)'; %>
                                        <% if (grp.includes('Телят') || grp.includes('до 6')) { %>
                                            <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-balloon-fill"></i> <%= grp %></span>
                                        <% } else if (grp.includes('Молодняк') || grp.includes('6–18') || grp.includes('6-18')) { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-flower1"></i> <%= grp %></span>
                                        <% } else if (grp.includes('Нетел') || grp.includes('> 18')) { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-shield-check"></i> <%= grp %></span>
                                        <% } else if (grp.includes('первотёл') || grp.includes('1-й лакт')) { %>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-gem"></i> <%= grp %></span>
                                        <% } else if (grp.includes('сухосто')) { %>
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-moon"></i> <%= grp %></span>
                                        <% } else if (grp.includes('Бычк')) { %>
                                            <span class="badge bg-dark-subtle text-dark border"><i class="bi bi-tag-fill"></i> <%= grp %></span>
                                        <% } else { %>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-droplet-half"></i> <%= grp %></span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (cow.lactation_phase && (cow.lactation_phase.includes('Молодняк') || (cow.age_group && (cow.age_group.includes('Телят') || cow.age_group.includes('Молодняк') || cow.age_group.includes('Бычки'))))) { %>
                                            <span class="badge bg-light text-muted border">Молодняк (0 дн)</span>
                                        <% } else { %>
                                            <div class="small fw-semibold">
                                                <%= cow.lactation ? 'Лакт. ' + cow.lactation : 'Взрослое' %>
                                                <% if (cow.lactation_days !== undefined && cow.lactation_days !== null) { %>
                                                    <span class="text-primary">• <%= cow.lactation_days %> дн. (DIM)</span>
                                                <% } %>
                                            </div>
                                            <% if (cow.lactation_phase) { %>
                                                <% if (cow.lactation_phase.includes('Новотел')) { %>
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="Высокий риск метаболических патологий">
                                                        <i class="bi bi-lightning-charge-fill"></i> <%= cow.lactation_phase %>
                                                    </span>
                                                <% } else if (cow.lactation_phase.includes('Раздой')) { %>
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                        <i class="bi bi-graph-up"></i> <%= cow.lactation_phase %>
                                                    </span>
                                                <% } else if (cow.lactation_phase.includes('Сухостой')) { %>
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                        <i class="bi bi-moon-stars"></i> <%= cow.lactation_phase %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                        <%= cow.lactation_phase %>
                                                    </span>
                                                <% } %>
                                            <% } %>
                                        <% } %>
                                    </td>
                                    <td><%= cow.weight ? cow.weight + ' кг' : '-' %></td>
                                    <td><span class="badge bg-light text-dark border"><%= cow.disposal_date %></span></td>
                                    <td class="text-end text-nowrap">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <a href="/edit_cow/<%= cow.id %>" class="btn btn-outline-primary btn-sm" title="Редактировать">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <% if (user_type !== 'admin') { %>
                                            <button type="button" class="btn btn-outline-danger btn-sm delete-cow-btn" 
                                                    data-cow-id="<%= cow.id %>" 
                                                    data-cow-number="<%= cow.cow_id %>"
                                                    title="Удалить запись">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr id="noDataRow">
                                    <td colspan="10" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        Записи о выбытии не найдены.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Нижняя панель пагинации -->
                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="alert alert-info py-2 px-3 mb-0 small">
                        <i class="bi bi-info-circle"></i> Всего в базе: <strong><%= total_cows_count %></strong> | 
                        Найдено по фильтрам: <strong id="row_count"><%= total_cows_count %></strong>
                        <% if (user_type === 'admin') { %>
                        | Ферм: <strong><%= (unique_farms || []).length %></strong>
                        <% } %>
                    </div>
                    <nav aria-label="Пагинация снизу">
                        <ul class="pagination pagination-sm mb-0" id="paginationBottom"></ul>
                    </nav>
                </div>
            </div>
        </div>
        
        <!-- Статистика по выбранному набору данных -->
        <div class="card mt-3 shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Статистика по фильтрам</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="card border-primary h-100">
                            <div class="card-body text-center">
                                <h3 class="text-primary mb-1" id="stat_cards_total"><%= (initial_stats && initial_stats.total) || total_cows_count %></h3>
                                <p class="text-muted small mb-0">Всего записей</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="card border-danger h-100">
                            <div class="card-body text-center">
                                <h3 class="text-danger mb-1" id="stat_cards_death"><%= (initial_stats && initial_stats.death) || 0 %></h3>
                                <p class="text-muted small mb-0">Падёж</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="card border-primary h-100">
                            <div class="card-body text-center">
                                <h3 class="text-primary mb-1" id="stat_cards_culling"><%= (initial_stats && initial_stats.culling) || 0 %></h3>
                                <p class="text-muted small mb-0">Выбраковка</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card border-warning h-100">
                            <div class="card-body text-center">
                                <h3 class="text-warning text-dark mb-1" id="stat_cards_sanitary"><%= (initial_stats && initial_stats.sanitary) || 0 %></h3>
                                <p class="text-muted small mb-0">Санитарный брак</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    var DISPOSAL_CATEGORIES = <%- JSON.stringify(categories || {}) %>;
    var IS_ADMIN = <%= user_type === 'admin' ? 'true' : 'false' %>;

    var currentPage = 1;
    var pageSize = 50;
    var totalFiltered = <%= total_cows_count %>;
    var totalDb = <%= total_cows_count %>;
    var totalPages = Math.ceil(<%= total_cows_count %> / pageSize) || 1;
        var isFetching = false;
        var activeRecordType = '<%= (typeof repro_filter !== "undefined" && repro_filter === "stillborn") ? "stillborn" : "live" %>';

        // Bind Record Type Tabs (Live / Stillborn / All)
        var tabBtns = document.querySelectorAll('.record-tab-btn');
        tabBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                var rType = this.getAttribute('data-record-type');
                activeRecordType = rType;
                tabBtns.forEach(function(b) {
                    b.classList.remove('active', 'btn-primary', 'btn-danger', 'btn-secondary');
                    b.classList.add('btn-outline-primary');
                });
                if (rType === 'stillborn') {
                    this.classList.remove('btn-outline-primary');
                    this.classList.add('btn-danger', 'active');
                } else if (rType === 'all') {
                    this.classList.remove('btn-outline-primary');
                    this.classList.add('btn-secondary', 'active');
                } else {
                    this.classList.remove('btn-outline-primary');
                    this.classList.add('btn-primary', 'active');
                }
                loadPage(1);
            });
        });

        var farmFilter = document.getElementById('farm_filter');
        var categoryFilter = document.getElementById('category_filter');
        var reasonFilter = document.getElementById('reason_filter');
        var ageGroupFilter = document.getElementById('age_group_filter');
        var lactationPhaseFilter = document.getElementById('lactation_phase_filter');
        var reproFilter = document.getElementById('repro_filter');
        var dateSort = document.getElementById('date_sort');
        var searchInput = document.getElementById('searchInput');
        var clearSearchBtn = document.getElementById('clearSearchBtn');
        var pageSizeSelect = document.getElementById('pageSizeSelect');
        var resetBtn = document.getElementById('reset_filters');
        var applyBtn = document.getElementById('apply_filters');

        var tableBody = document.getElementById('cowsTableBody');
        var rowCountSpan = document.getElementById('row_count');
        var pageInfoText = document.getElementById('pageInfoText');
        var badgeFilteredCount = document.getElementById('badgeFilteredCount');
        var bannerTotalCount = document.getElementById('bannerTotalCount');
        var headerCountBadge = document.getElementById('headerCountBadge');
        var paginationTop = document.getElementById('paginationTop');
        var paginationBottom = document.getElementById('paginationBottom');
        var tableSpinner = document.getElementById('tableSpinner');

        var statTotal = document.getElementById('stat_cards_total');
        var statDeath = document.getElementById('stat_cards_death');
        var statCulling = document.getElementById('stat_cards_culling');
        var statSanitary = document.getElementById('stat_cards_sanitary');

        // Мгновенное синхронное заполнение причин без сетевых задержек (0 мс)
        function updateReasonsDropdown(category) {
            if (!reasonFilter) return;
            reasonFilter.innerHTML = '<option value="">Все причины</option>';
            if (!category) {
                reasonFilter.disabled = true;
                return;
            }

            var catLower = category.toLowerCase();
            var reasons = DISPOSAL_CATEGORIES[catLower] || [];
            if (reasons.length === 0) {
                // Поиск по подстроке
                for (var key in DISPOSAL_CATEGORIES) {
                    if (key.includes(catLower) || catLower.includes(key)) {
                        reasons = DISPOSAL_CATEGORIES[key];
                        break;
                    }
                }
            }

            reasons.forEach(function(r) {
                var opt = document.createElement('option');
                opt.value = r;
                opt.textContent = r;
                reasonFilter.appendChild(opt);
            });
            reasonFilter.disabled = false;
        }

        // Отрисовка строк таблицы (быстро, < 1 мс)
        function renderRows(cows) {
            if (!tableBody) return;

            if (!cows || cows.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="10" class="text-center py-5 text-muted">' +
                    '<i class="bi bi-inbox fs-1 d-block mb-2"></i>Записи по выбранным фильтрам не найдены.</td></tr>';
                return;
            }

            var html = '';
            for (var i = 0; i < cows.length; i++) {
                var c = cows[i];
                var catBadge = '<span class="badge bg-warning text-dark">Санитарный брак</span>';
                if (c.category === 'падёж') {
                    catBadge = '<span class="badge bg-danger">Падёж</span>';
                } else if (c.category === 'выбраковка') {
                    catBadge = '<span class="badge bg-primary">Выбраковка</span>';
                }

                var earTagHtml = c.ear_tag ? '<span class="badge bg-secondary font-monospace">' + escapeHtml(c.ear_tag) + '</span>' : '<span class="text-muted">-</span>';
                var weightHtml = c.weight ? (c.weight + ' кг') : '-';
                
                // Категория скота (бейдж)
                var grp = c.age_group || 'Коровы 2+ лактаций (полновозрастные)';
                var grpBadge = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-droplet-half"></i> ' + escapeHtml(grp) + '</span>';
                if (grp.indexOf('Телят') !== -1 || grp.indexOf('до 6') !== -1) {
                    grpBadge = '<span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-balloon-fill"></i> ' + escapeHtml(grp) + '</span>';
                } else if (grp.indexOf('Молодняк') !== -1 || grp.indexOf('6–18') !== -1 || grp.indexOf('6-18') !== -1) {
                    grpBadge = '<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-flower1"></i> ' + escapeHtml(grp) + '</span>';
                } else if (grp.indexOf('Нетел') !== -1 || grp.indexOf('> 18') !== -1) {
                    grpBadge = '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-shield-check"></i> ' + escapeHtml(grp) + '</span>';
                } else if (grp.indexOf('первотёл') !== -1 || grp.indexOf('1-й лакт') !== -1) {
                    grpBadge = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-gem"></i> ' + escapeHtml(grp) + '</span>';
                } else if (grp.indexOf('сухосто') !== -1) {
                    grpBadge = '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-moon"></i> ' + escapeHtml(grp) + '</span>';
                } else if (grp.indexOf('Бычк') !== -1) {
                    grpBadge = '<span class="badge bg-dark-subtle text-dark border"><i class="bi bi-tag-fill"></i> ' + escapeHtml(grp) + '</span>';
                }

                // Лактация и DIM
                var lactHtml = '';
                var isYoung = (c.lactation_phase && c.lactation_phase.indexOf('Молодняк') !== -1) ||
                              (grp.indexOf('Телят') !== -1 || grp.indexOf('Молодняк') !== -1 || grp.indexOf('Бычки') !== -1);

                if (isYoung) {
                    lactHtml = '<span class="badge bg-light text-muted border">Молодняк (0 дн)</span>';
                } else {
                    var lNum = c.lactation ? ('Лакт. ' + c.lactation) : 'Взрослое';
                    var dimText = (c.lactation_days !== undefined && c.lactation_days !== null) ? (' <span class="text-primary">• ' + c.lactation_days + ' дн. (DIM)</span>') : '';
                    lactHtml = '<div class="small fw-semibold">' + lNum + dimText + '</div>';

                    if (c.lactation_phase) {
                        var lp = c.lactation_phase;
                        if (lp.indexOf('Новотел') !== -1) {
                            lactHtml += '<span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="Высокий риск метаболических нарушений"><i class="bi bi-lightning-charge-fill"></i> ' + escapeHtml(lp) + '</span>';
                        } else if (lp.indexOf('Раздой') !== -1) {
                            lactHtml += '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-graph-up"></i> ' + escapeHtml(lp) + '</span>';
                        } else if (lp.indexOf('Сухостой') !== -1) {
                            lactHtml += '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-moon-stars"></i> ' + escapeHtml(lp) + '</span>';
                        } else {
                            lactHtml += '<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">' + escapeHtml(lp) + '</span>';
                        }
                    }
                }

                var actionsHtml = '<a href="/edit_cow/' + c.id + '" class="btn btn-outline-primary btn-sm" title="Редактировать"><i class="bi bi-pencil"></i></a>';
                if (!IS_ADMIN) {
                    actionsHtml += '<button type="button" class="btn btn-outline-danger btn-sm delete-cow-btn" data-cow-id="' + c.id + '" data-cow-number="' + escapeHtml(c.cow_id) + '" title="Удалить"><i class="bi bi-trash"></i></button>';
                }

                var reproBadge = '';
                if (c.is_pregnant === 1) {
                    var gTxt = c.gestation_days ? (' (' + Math.round(c.gestation_days / 30 * 10) / 10 + ' мес.)') : '';
                    reproBadge = ' <span class="badge bg-warning-subtle text-dark border border-warning-subtle ms-1" title="Срок стельности: ' + (c.gestation_days || 0) + ' дн."><i class="bi bi-suit-heart-fill text-danger me-1"></i>Стельная' + gTxt + '</span>';
                }
                if (c.is_stillborn === 1) {
                    reproBadge += ' <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1"><i class="bi bi-x-circle-fill me-1"></i>Мертворожд.</span>';
                }

                html += '<tr class="cow-row" data-id="' + c.id + '">' +
                    '<td><strong class="text-primary font-monospace">' + escapeHtml(c.cow_id) + '</strong></td>' +
                    '<td>' + earTagHtml + '</td>' +
                    '<td><i class="bi bi-building"></i> ' + escapeHtml(c.farm_name) + '</td>' +
                    '<td>' + catBadge + '</td>' +
                    '<td class="fw-semibold">' + escapeHtml(c.reason) + reproBadge + '</td>' +
                    '<td>' + grpBadge + '</td>' +
                    '<td>' + lactHtml + '</td>' +
                    '<td>' + weightHtml + '</td>' +
                    '<td><span class="badge bg-light text-dark border">' + escapeHtml(c.disposal_date) + '</span></td>' +
                    '<td class="text-end text-nowrap"><div class="d-flex gap-1 justify-content-end">' + actionsHtml + '</div></td>' +
                    '</tr>';
            }

            tableBody.innerHTML = html;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // Отрисовка пагинации
        function renderPaginationControls() {
            var pagHtml = '';
            if (totalPages > 1) {
                pagHtml += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">';
                pagHtml += '<a class="page-link" href="#" data-page="' + (currentPage - 1) + '">&laquo;</a></li>';

                var startPage = Math.max(1, currentPage - 2);
                var endPage = Math.min(totalPages, currentPage + 2);

                if (startPage > 1) {
                    pagHtml += '<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>';
                    if (startPage > 2) pagHtml += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                }

                for (var p = startPage; p <= endPage; p++) {
                    pagHtml += '<li class="page-item ' + (p === currentPage ? 'active' : '') + '">';
                    pagHtml += '<a class="page-link" href="#" data-page="' + p + '">' + p + '</a></li>';
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) pagHtml += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                    pagHtml += '<li class="page-item"><a class="page-link" href="#" data-page="' + totalPages + '">' + totalPages + '</a></li>';
                }

                pagHtml += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '">';
                pagHtml += '<a class="page-link" href="#" data-page="' + (currentPage + 1) + '">&raquo;</a></li>';
            }

            if (paginationTop) paginationTop.innerHTML = pagHtml;
            if (paginationBottom) paginationBottom.innerHTML = pagHtml;
        }

        // Быстрый запрос данных через API (< 2 мс)
        var fetchTimeoutTimer = null;
        function loadPage(pageToLoad) {
            if (isFetching) return;
            isFetching = true;

            var targetPage = pageToLoad ? parseInt(pageToLoad, 10) : currentPage;
            if (isNaN(targetPage) || targetPage < 1) targetPage = 1;

            if (tableSpinner) tableSpinner.style.display = 'inline-block';

            // Автоматическая разблокировка флага загрузки через 3 секунды
            clearTimeout(fetchTimeoutTimer);
            fetchTimeoutTimer = setTimeout(function() {
                isFetching = false;
                if (tableSpinner) tableSpinner.style.display = 'none';
            }, 3000);

            var farmVal = farmFilter && farmFilter.tagName === 'SELECT' ? (farmFilter.value || '') : '';
            var catVal = categoryFilter ? (categoryFilter.value || '') : '';
            var reasonVal = reasonFilter ? (reasonFilter.value || '') : '';
            var ageGroupVal = ageGroupFilter ? (ageGroupFilter.value || '') : '';
            var lactPhaseVal = lactationPhaseFilter ? (lactationPhaseFilter.value || '') : '';
            var reproVal = reproFilter ? (reproFilter.value || '') : '';
            var sortVal = dateSort ? (dateSort.value || 'newest') : 'newest';
            var searchVal = searchInput ? (searchInput.value || '').trim() : '';

            var url = '/api/cows?page=' + targetPage +
                '&limit=' + encodeURIComponent(pageSize) +
                '&record_type=' + encodeURIComponent(activeRecordType) +
                '&farm=' + encodeURIComponent(farmVal) +
                '&category=' + encodeURIComponent(catVal) +
                '&reason=' + encodeURIComponent(reasonVal) +
                '&age_group=' + encodeURIComponent(ageGroupVal) +
                '&lactation_phase=' + encodeURIComponent(lactPhaseVal) +
                '&repro_filter=' + encodeURIComponent(reproVal) +
                '&start_date=' + encodeURIComponent(activeStartDate || '') +
                '&end_date=' + encodeURIComponent(activeEndDate || '') +
                '&sort=' + encodeURIComponent(sortVal) +
                '&search=' + encodeURIComponent(searchVal);

            fetch(url)
                .then(function(res) {
                    if (!res.ok) throw new Error('Ошибка сервера (код ' + res.status + ')');
                    return res.json();
                })
                .then(function(data) {
                    clearTimeout(fetchTimeoutTimer);
                    isFetching = false;
                    if (tableSpinner) tableSpinner.style.display = 'none';
                    if (!data.success) return;

                    totalFiltered = data.total_filtered;
                    totalPages = data.total_pages || 1;
                    currentPage = data.page || targetPage; // Обновляем текущую страницу строго при успехе!

                    renderRows(data.cows);
                    renderPaginationControls();

                    // Обновление счётчиков
                    if (rowCountSpan) rowCountSpan.textContent = totalFiltered;
                    if (badgeFilteredCount) badgeFilteredCount.textContent = totalFiltered;
                    if (pageInfoText) {
                        if (totalFiltered === 0) {
                            pageInfoText.textContent = 'Ничего не найдено';
                        } else {
                            pageInfoText.innerHTML = 'Показано <strong>' + data.start_index + '–' + data.end_index + '</strong> из <strong>' + totalFiltered + '</strong> записей ' +
                                '(Страница ' + currentPage + ' из ' + totalPages + ')';
                        }
                    }

                    if (data.stats) {
                        if (statTotal) statTotal.textContent = data.stats.total;
                        if (statDeath) statDeath.textContent = data.stats.death;
                        if (statCulling) statCulling.textContent = data.stats.culling;
                        if (statSanitary) statSanitary.textContent = data.stats.sanitary;
                    }
                })
                .catch(function(err) {
                    clearTimeout(fetchTimeoutTimer);
                    isFetching = false;
                    if (tableSpinner) tableSpinner.style.display = 'none';
                    console.error('Ошибка загрузки коров:', err);
                });
        }

        // Обработчики событий
        if (categoryFilter) {
            categoryFilter.addEventListener('change', function() {
                updateReasonsDropdown(this.value);
                loadPage(1);
            });
        }

        if (farmFilter) {
            farmFilter.addEventListener('change', function() { loadPage(1); });
        }

        if (reasonFilter) {
            reasonFilter.addEventListener('change', function() { loadPage(1); });
        }

        if (ageGroupFilter) {
            ageGroupFilter.addEventListener('change', function() { loadPage(1); });
        }

        if (lactationPhaseFilter) {
            lactationPhaseFilter.addEventListener('change', function() { loadPage(1); });
        }

        if (reproFilter) {
            reproFilter.addEventListener('change', function() { loadPage(1); });
        }

        if (dateSort) {
            dateSort.addEventListener('change', function() { loadPage(1); });
        }

        if (pageSizeSelect) {
            pageSizeSelect.addEventListener('change', function() {
                pageSize = parseInt(this.value, 10) || 50;
                loadPage(1);
            });
        }

        if (applyBtn) {
            applyBtn.addEventListener('click', function() { loadPage(1); });
        }

        if (resetBtn) {
            resetBtn.addEventListener('click', function() {
                if (farmFilter && farmFilter.tagName === 'SELECT') farmFilter.value = '';
                if (categoryFilter) categoryFilter.value = '';
                if (reasonFilter) {
                    reasonFilter.value = '';
                    reasonFilter.disabled = true;
                }
                if (ageGroupFilter) ageGroupFilter.value = '';
                if (lactationPhaseFilter) lactationPhaseFilter.value = '';
                if (reproFilter) reproFilter.value = '';
                if (dateSort) dateSort.value = 'newest';
                if (searchInput) {
                    searchInput.value = '';
                    if (clearSearchBtn) clearSearchBtn.style.display = 'none';
                }
                loadPage(1);
            });
        }

        // Поиск с дебаунсом 150 мс
        var searchTimer = null;
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                var val = this.value.trim();
                if (clearSearchBtn) {
                    clearSearchBtn.style.display = val.length > 0 ? 'inline-block' : 'none';
                }
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function() {
                    loadPage(1);
                }, 150);
            });
        }

        if (clearSearchBtn) {
            clearSearchBtn.addEventListener('click', function() {
                searchInput.value = '';
                this.style.display = 'none';
                loadPage(1);
            });
        }

        // Клики по пагинации
        document.addEventListener('click', function(e) {
            var target = e.target.closest('.page-link');
            if (target && target.getAttribute('data-page')) {
                e.preventDefault();
                var p = parseInt(target.getAttribute('data-page'), 10);
                if (!isNaN(p) && p >= 1 && p <= totalPages && p !== currentPage) {
                    loadPage(p);
                    var tbl = document.getElementById('cowsTable');
                    if (tbl) {
                        window.scrollTo({
                            top: tbl.getBoundingClientRect().top + window.pageYOffset - 100,
                            behavior: 'smooth'
                        });
                    }
                }
            }
        });

        // Удаление коровы через AJAX
        document.addEventListener('click', function(e) {
            var delBtn = e.target.closest('.delete-cow-btn');
            if (delBtn) {
                var cowId = delBtn.getAttribute('data-cow-id');
                var cowNum = delBtn.getAttribute('data-cow-number');
                if (confirm('Вы уверены, что хотите удалить запись о корове ' + cowNum + '?')) {
                    fetch('/delete_cow/' + cowId, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.success) {
                            loadPage(currentPage);
                        } else {
                            alert(data.error || 'Ошибка удаления');
                        }
                    })
                    .catch(function(err) {
                        console.error('Ошибка сети:', err);
                        alert('Ошибка сети при удалении');
                    });
                }
            }
        });

        // Чтение параметров URL (deep linking с дашборда и отчетов)
        var urlParams = new URLSearchParams(window.location.search);
        var hasInitialFilter = false;
        var activeStartDate = '';
        var activeEndDate = '';

        if (urlParams.has('farm') && farmFilter && farmFilter.tagName === 'SELECT') {
            farmFilter.value = urlParams.get('farm');
            hasInitialFilter = true;
        }
        if (urlParams.has('category') && categoryFilter) {
            categoryFilter.value = urlParams.get('category');
            updateReasonsDropdown(categoryFilter.value);
            hasInitialFilter = true;
        }
        if (urlParams.has('reason') && reasonFilter) {
            reasonFilter.value = urlParams.get('reason');
            hasInitialFilter = true;
        }
        if (urlParams.has('age_group') && ageGroupFilter) {
            var paramAge = urlParams.get('age_group');
            var matchedVal = '';
            for (var oi = 0; oi < ageGroupFilter.options.length; oi++) {
                var ov = ageGroupFilter.options[oi].value;
                if (!ov) continue;
                var ovL = ov.toLowerCase();
                var paL = paramAge.toLowerCase();
                if (ov === paramAge) { matchedVal = ov; break; }
                if ((paL.indexOf('полновозраст') !== -1 || paL.indexOf('2+') !== -1) && (ovL.indexOf('полновозраст') !== -1 || ovL.indexOf('2+') !== -1)) { matchedVal = ov; break; }
                if ((paL.indexOf('первотел') !== -1 || paL.indexOf('1') !== -1) && (ovL.indexOf('первотел') !== -1 || ovL.indexOf('1') !== -1)) { matchedVal = ov; break; }
                if ((paL.indexOf('телят') !== -1 || (paL.indexOf('6') !== -1 && paL.indexOf('18') === -1)) && ovL.indexOf('телят') !== -1) { matchedVal = ov; break; }
                if (paL.indexOf('молод') !== -1 && ovL.indexOf('молод') !== -1) { matchedVal = ov; break; }
                if (paL.indexOf('нетел') !== -1 && ovL.indexOf('нетел') !== -1) { matchedVal = ov; break; }
                if (paL.indexOf('быч') !== -1 && ovL.indexOf('быч') !== -1) { matchedVal = ov; break; }
                if (paL.indexOf('сухост') !== -1 && ovL.indexOf('сухост') !== -1) { matchedVal = ov; break; }
            }
            ageGroupFilter.value = matchedVal || paramAge;
            hasInitialFilter = true;
        }
        if (urlParams.has('lactation_phase') && lactationPhaseFilter) {
            lactationPhaseFilter.value = urlParams.get('lactation_phase');
            hasInitialFilter = true;
        }
        if (urlParams.has('repro_filter') && reproFilter) {
            reproFilter.value = urlParams.get('repro_filter');
            hasInitialFilter = true;
        }
        if (urlParams.has('start_date') && urlParams.has('end_date')) {
            activeStartDate = urlParams.get('start_date') || '';
            activeEndDate = urlParams.get('end_date') || '';
            hasInitialFilter = true;
        }

        if (hasInitialFilter) {
            loadPage(1);
        } else {
            // Первичная отрисовка контролов пагинации
            renderPaginationControls();
    })();
    </script>

<%- include('layout/footer') %>
