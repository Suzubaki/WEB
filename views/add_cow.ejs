<%- include('layout/header', { title: 'Добавление записи - Учёт выбытия и мертворождений КРС' }) %>

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        
        <!-- Переключатель типа записи -->
        <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
            <div class="card-body p-2 bg-light">
                <div class="nav nav-pills nav-justified gap-2" id="entry-mode-tabs" role="tablist">
                    <button class="nav-link active rounded-3 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2 text-primary" id="mode-cow-tab" data-bs-toggle="pill" data-bs-target="#mode-cow" type="button" role="tab">
                        <i class="bi bi-card-checklist fs-5"></i>
                        <span>Выбытие взрослого скота / молодняка</span>
                    </button>
                    <button class="nav-link rounded-3 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2 text-danger" id="mode-stillborn-tab" data-bs-toggle="pill" data-bs-target="#mode-stillborn" type="button" role="tab">
                        <i class="bi bi-heartbreak-fill fs-5"></i>
                        <span>Регистрация мертворождения / аборта</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="tab-content" id="entry-mode-content">
            <!-- ТАБ 1: Выбытие взрослого скота и молодняка -->
            <div class="tab-pane fade show active" id="mode-cow" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-primary bg-gradient text-white py-3 px-4 d-flex justify-content-between align-items-center rounded-top-4 border-0">
                        <div>
                            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle-fill me-2"></i>Акт выбытия животного (ф. 209-АПК / AITS)</h5>
                            <small class="opacity-75">Учёт падежа, выбраковки и санитарного брака КРС</small>
                        </div>
                        <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-semibold shadow-sm">Ферма: <%= farm_name %></span>
                    </div>
                    <div class="card-body p-4">
                        <form method="POST" action="/add_cow">
                            <input type="hidden" name="form_mode" value="cow">

                            <!-- Секция 1: Категория, причина, дата -->
                            <div class="mb-4">
                                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">
                                    <i class="bi bi-1-circle-fill text-primary me-1"></i> Основные параметры выбытия
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label for="category" class="form-label fw-semibold">Вид выбытия *</label>
                                        <select class="form-select border-primary-subtle" id="category" name="category" required>
                                            <option value="">Выберите вид...</option>
                                            <option value="падёж">Падёж</option>
                                            <option value="выбраковка">Выбраковка</option>
                                            <option value="санитарный">Санитарный брак</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <label for="reason" class="form-label fw-semibold">Причина / Ветеринарный диагноз *</label>
                                        <select class="form-select border-primary-subtle" id="reason" name="reason" disabled required>
                                            <option value="">Сначала выберите вид выбытия</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="disposal_date" class="form-label fw-semibold">Дата события *</label>
                                        <input type="date" class="form-control border-primary-subtle" id="disposal_date" name="disposal_date" required>
                                    </div>
                                </div>
                            </div>

                            <!-- Секция 2: Паспортные данные -->
                            <div class="mb-4">
                                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">
                                    <i class="bi bi-2-circle-fill text-primary me-1"></i> Идентификация и группа
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label for="ear_tag" class="form-label fw-semibold">Идетифик. № (Бирка AITS)</label>
                                        <input type="text" class="form-control" id="ear_tag" name="ear_tag" placeholder="BY 04 1234567">
                                    </div>
                                    <div class="col-md-4">
                                        <label for="breed" class="form-label fw-semibold">Порода скота</label>
                                        <select class="form-select" id="breed" name="breed">
                                            <option value="Черно-пёстрая белорусской селекции" selected>Черно-пёстрая белорусской селекции</option>
                                            <option value="Голштинская">Голштинская</option>
                                            <option value="Красная белорусская">Красная белорусская</option>
                                            <option value="Симментальская">Симментальская</option>
                                            <option value="Лимузин">Лимузин</option>
                                            <option value="Помесь">Помесь</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="age_group" class="form-label fw-semibold">Половозрастная группа (ПВГ)</label>
                                        <select class="form-select border-primary-subtle fw-semibold" id="age_group" name="age_group">
                                            <option value="Телята (до 6 мес.)">Телята (до 6 мес., молочный период)</option>
                                            <option value="Молодняк (от 6 до 18 мес.)">Ремонтный молодняк (6–18 мес.)</option>
                                            <option value="Нетели и тёлки (> 18 мес.)">Нетели и тёлки (> 18 мес.)</option>
                                            <option value="Новотельные коровы (0–30 дн DIM)">Выбытие новотельных (0–30 дн DIM)</option>
                                            <option value="Коровы 1-й лактации (первотёлки)">Коровы 1-й лактации (первотёлки)</option>
                                            <option value="Коровы 2+ лактаций (полновозрастные)" selected>Коровы 2+ лактаций (полновозрастные)</option>
                                            <option value="Коровы сухостойные">Коровы сухостойные</option>
                                            <option value="Бычки на откорме">Бычки на откорме</option>
                                            <option value="Мертворождённые / Аборты">Мертворождённые / Аборты (внутриутробные потери)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Секция 3: Физиологические показатели -->
                            <div class="mb-4">
                                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">
                                    <i class="bi bi-3-circle-fill text-primary me-1"></i> Физиологические и финансовые показатели
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-2">
                                        <label for="lactation" class="form-label fw-semibold">Лактация №</label>
                                        <input type="number" class="form-control" id="lactation" name="lactation" min="0" max="20" placeholder="0..15">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="lactation_days" class="form-label fw-semibold text-primary">Дни лактации (DIM)</label>
                                        <input type="number" class="form-control" id="lactation_days" name="lactation_days" min="0" max="999" placeholder="Дней DIM">
                                        <div class="mt-1" id="lactationPhaseBadge">
                                            <span class="badge bg-light text-muted border">Фаза рассчитывается авто</span>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="weight" class="form-label fw-semibold">Масса (кг)</label>
                                        <input type="number" step="0.1" class="form-control" id="weight" name="weight" min="0" placeholder="кг">
                                    </div>
                                    <div class="col-md-2">
                                        <label for="milk_yield" class="form-label fw-semibold">Удой (кг)</label>
                                        <input type="number" step="1" class="form-control" id="milk_yield" name="milk_yield" min="0" placeholder="кг">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="book_value" class="form-label fw-semibold">Балансовая ст. (BYN)</label>
                                        <input type="number" step="0.01" class="form-control" id="book_value" name="book_value" min="0" placeholder="BYN">
                                    </div>
                                </div>
                            </div>

                            <!-- Секция 4: Материнская стельность -->
                            <div class="p-3 bg-light rounded-3 border border-primary-subtle mb-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-suit-heart-fill text-danger fs-5"></i>
                                    <span class="fw-bold text-dark">Материнская стельность на дату выбытия</span>
                                </div>
                                <div class="row g-3 align-items-center">
                                    <div class="col-md-6">
                                        <div class="form-check form-switch fs-6">
                                            <input class="form-check-input" type="checkbox" id="is_pregnant" name="is_pregnant" value="1">
                                            <label class="form-check-label fw-semibold text-dark" for="is_pregnant">
                                                Корова была стельной на момент выбытия
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white small text-muted">Срок стельности:</span>
                                            <input type="number" class="form-control" id="gestation_days" name="gestation_days" min="0" max="300" placeholder="Дней (напр. 180)">
                                            <span class="input-group-text bg-white small text-muted">дн.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Секция 5: Примечание -->
                            <div class="mb-4">
                                <label for="notes" class="form-label fw-semibold">Заключение комиссии / Примечание</label>
                                <input type="text" class="form-control" id="notes" name="notes" placeholder="Клиника, анамнез, заключение ветеринарного врача...">
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <a href="/cows" class="btn btn-outline-secondary px-4 rounded-3">
                                    <i class="bi bi-arrow-left me-1"></i> В журнал коров
                                </a>
                                <button type="submit" class="btn btn-primary px-5 rounded-3 fw-bold">
                                    <i class="bi bi-check-circle-fill me-2"></i> Сохранить запись
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- ТАБ 2: Обособленная регистрация мертворождения или аборта -->
            <div class="tab-pane fade" id="mode-stillborn" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-danger bg-gradient text-white py-3 px-4 d-flex justify-content-between align-items-center rounded-top-4 border-0">
                        <div>
                            <h5 class="mb-0 fw-bold"><i class="bi bi-heartbreak-fill me-2"></i>Учёт мертворождённых телят и абортов</h5>
                            <small class="opacity-75">Регистрация гибели плода, мертворождений и эмбриональной смертности</small>
                        </div>
                        <span class="badge bg-white text-danger px-3 py-2 rounded-pill fw-semibold shadow-sm">Ферма: <%= farm_name %></span>
                    </div>
                    <div class="card-body p-4">
                        <form method="POST" action="/add_cow">
                            <input type="hidden" name="form_mode" value="stillborn">
                            <input type="hidden" name="category" value="падёж">
                            <input type="hidden" name="is_stillborn" value="1">
                            <input type="hidden" name="is_pregnant" value="0">

                            <div class="alert alert-danger bg-danger-subtle text-danger-emphasis border-0 rounded-3 mb-4 d-flex align-items-center gap-3">
                                <i class="bi bi-exclamation-triangle-fill fs-3 text-danger"></i>
                                <div>
                                    <strong>Обособленный зоотехнический учёт:</strong> Данная форма регистрирует потерю плода (мертворождённый телёнок или аборт). Запись сразу же включается в аналитику воспроизводства и потерь стельности.
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label for="sb_reason" class="form-label fw-bold text-dark">Вид патологии плода / Причина аборта *</label>
                                    <select class="form-select border-danger-subtle" id="sb_reason" name="reason" required>
                                        <option value="">Выберите патологию...</option>
                                        <option value="Мертворождённый телёнок (в срок)" selected>Мертворождённый телёнок (в срок)</option>
                                        <option value="Аборт (1-й триместр, до 90 дн)">Аборт (1-й триместр, до 90 дн)</option>
                                        <option value="Аборт (2-й триместр, 91-180 дн)">Аборт (2-й триместр, 91-180 дн)</option>
                                        <option value="Аборт (3-й триместр, 181-240 дн)">Аборт (3-й триместр, 181-240 дн)</option>
                                        <option value="Мумификация / мацерация плода">Мумификация / мацерация плода</option>
                                        <option value="Патология родов / гибель при родовспоможении">Патология родов / гибель при родовспоможении</option>
                                        <option value="Инфекционный аборт (бруцеллез, хламидиоз)">Инфекционный аборт</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="sb_disposal_date" class="form-label fw-bold text-dark">Дата абортирования / мертворождения *</label>
                                    <input type="date" class="form-control border-danger-subtle" id="sb_disposal_date" name="disposal_date" required>
                                </div>

                                <div class="col-md-4">
                                    <label for="sb_ear_tag" class="form-label fw-semibold">Инв. № матери (коровы/нетели)</label>
                                    <input type="text" class="form-control" id="sb_ear_tag" name="ear_tag" placeholder="Напр. Корова № 4512 / AITS">
                                </div>

                                <div class="col-md-4">
                                    <label for="sb_gestation_days" class="form-label fw-semibold">Срок стельности матери (дней)</label>
                                    <input type="number" class="form-control" id="sb_gestation_days" name="gestation_days" min="0" max="300" placeholder="Напр. 210 дн.">
                                </div>

                                <div class="col-md-4">
                                    <label for="sb_weight" class="form-label fw-semibold">Масса плода / телёнка (кг)</label>
                                    <input type="number" step="0.1" class="form-control" id="sb_weight" name="weight" min="0" placeholder="Напр. 28.5 кг">
                                </div>
                                <input type="hidden" name="age_group" value="Мертворождённый телёнок">

                                <div class="col-md-8">
                                    <label for="sb_notes" class="form-label fw-semibold">Заключение ветврача / Причина патологии</label>
                                    <input type="text" class="form-control" id="sb_notes" name="notes" placeholder="Патологоанатомические данные, заключение лаборатории...">
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <a href="/cows" class="btn btn-outline-secondary px-4 rounded-3">
                                    <i class="bi bi-arrow-left me-1"></i> В журнал коров
                                </a>
                                <button type="submit" class="btn btn-danger px-5 rounded-3 fw-bold">
                                    <i class="bi bi-heartbreak-fill me-2"></i> Зарегистрировать мертворождение
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    var today = new Date().toISOString().split('T')[0];
    var dateInput = document.getElementById('disposal_date');
    if (dateInput) {
        dateInput.value = today;
        dateInput.max = today;
    }

    var catSelect = document.getElementById('category');
    var reasonSelect = document.getElementById('reason');
    var ageGroupSelect = document.getElementById('age_group');
    var dimInput = document.getElementById('lactation_days');
    var lactInput = document.getElementById('lactation');
    var badge = document.getElementById('lactation_phase_badge');
    var lactAlert = document.getElementById('lactation_alert');

    function updateLactationUI() {
        var ag = ageGroupSelect ? ageGroupSelect.value : '';
        var isYoung = ag.includes('Телят') || ag.includes('Молодняк') || ag.includes('Бычк');
        var isHeifer = ag.includes('Нетели');
        var isDry = ag.includes('сухосто');
        var isFreshGroup = ag.includes('Новотел') || ag.includes('0–30') || ag.includes('0-30');
        var isStillbornGroup = ag.includes('Мертворожд') || ag.includes('Аборт');

        if (isStillbornGroup) {
            badge.className = 'badge bg-danger px-3 py-2 fs-6';
            badge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Мертворождённый телёнок / Аборт';
            dimInput.value = '0';
            dimInput.disabled = true;
            lactInput.value = '0';
            lactInput.disabled = true;
            if (lactAlert) lactAlert.innerHTML = '<span class="text-danger"><i class="bi bi-info-circle"></i> Запись классифицируется как потеря приплода (аборт/мертворождение).</span>';
            return;
        }

        if (isFreshGroup) {
            if (!dimInput.value || dimInput.value === '0') {
                dimInput.value = '15';
            }
            dimInput.disabled = false;
            lactInput.disabled = false;
            badge.className = 'badge bg-danger px-3 py-2 fs-6';
            badge.innerHTML = '<i class="bi bi-exclamation-octagon-fill"></i> Новотел (0–30 дн DIM) • Критическая зона!';
            if (lactAlert) lactAlert.innerHTML = '<span class="text-danger fw-semibold"><i class="bi bi-shield-exclamation"></i> Выбрана группа новотельных коров. Дни лактации (DIM) установлены в диапазоне 0–30 дн.</span>';
            return;
        }

        if (isYoung) {
            badge.className = 'badge bg-success px-3 py-2 fs-6';
            badge.innerHTML = '<i class="bi bi-flower1"></i> Молодняк (не лактирует)';
            dimInput.value = '0';
            dimInput.disabled = true;
            lactInput.value = '0';
            lactInput.disabled = true;
            if (lactAlert) lactAlert.innerHTML = '<span class="text-success"><i class="bi bi-info-circle"></i> Для молодняка дни лактации не рассчитываются. Укажите живую массу.</span>';
            return;
        }

        if (isHeifer) {
            badge.className = 'badge bg-info text-dark px-3 py-2 fs-6';
            badge.innerHTML = '<i class="bi bi-gem"></i> Нетели (до первого отёла)';
            dimInput.value = '0';
            dimInput.disabled = true;
            lactInput.value = '0';
            lactInput.disabled = true;
            if (lactAlert) lactAlert.innerHTML = '<span class="text-info"><i class="bi bi-info-circle"></i> Нетели готовятся к первому отёлу, лактация отсутствует.</span>';
            return;
        }

        if (isDry) {
            badge.className = 'badge bg-secondary px-3 py-2 fs-6';
            badge.innerHTML = '<i class="bi bi-moon-stars"></i> Сухостойный период';
            dimInput.value = '0';
            dimInput.disabled = true;
            lactInput.disabled = false;
            if (lactAlert) lactAlert.innerHTML = '<span class="text-secondary"><i class="bi bi-info-circle"></i> Период сухостоя (доение прекращено). Укажите номер завершённой лактации.</span>';
            return;
        }

        // Дойные коровы
        dimInput.disabled = false;
        lactInput.disabled = false;
        var dimVal = parseInt(dimInput.value, 10);

        if (isNaN(dimVal) || dimInput.value === '') {
            badge.className = 'badge bg-light text-dark border px-3 py-2 fs-6';
            badge.textContent = 'Введите дни лактации (DIM)';
            lactAlert.textContent = 'Укажите число дней от последнего отёла до выбытия.';
            return;
        }

        if (dimVal <= 30) {
            badge.className = 'badge bg-danger px-3 py-2 fs-6';
            badge.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> Новотел (0–30 дн) • Высокий риск!';
            lactAlert.innerHTML = '<span class="text-danger fw-semibold"><i class="bi bi-shield-exclamation"></i> Критическая зона риска: послеродовые парезы, кетоз, метрит, гинекология.</span>';
        } else if (dimVal <= 100) {
            badge.className = 'badge bg-primary px-3 py-2 fs-6';
            badge.innerHTML = '<i class="bi bi-graph-up-arrow"></i> Раздой / Пик (31–100 дн)';
            lactAlert.innerHTML = '<span class="text-primary"><i class="bi bi-info-circle"></i> Период наивысшей молочной продуктивности (риск маститов и ацидозов).</span>';
        } else if (dimVal <= 200) {
            badge.className = 'badge bg-info text-dark px-3 py-2 fs-6';
            badge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Середина лактации (101–200 дн)';
            lactAlert.innerHTML = '<span class="text-muted">Стабильная лактация (риски: конечности, хромота).</span>';
        } else {
            badge.className = 'badge bg-secondary px-3 py-2 fs-6';
            badge.innerHTML = '<i class="bi bi-clock-history"></i> Спад лактации (201–305+ дн)';
            lactAlert.innerHTML = '<span class="text-muted">Завершающая стадия лактации (риски: яловость, выбраковка).</span>';
        }
    }

    if (ageGroupSelect) {
        ageGroupSelect.addEventListener('change', updateLactationUI);
    }
    if (dimInput) {
        dimInput.addEventListener('input', updateLactationUI);
    }
    updateLactationUI();

    if (catSelect && reasonSelect) {
        catSelect.addEventListener('change', function() {
            var category = this.value;

            if (category) {
                fetch('/get_reasons/' + encodeURIComponent(category))
                    .then(function(r) { return r.json(); })
                    .then(function(reasons) {
                        reasonSelect.innerHTML = '<option value="">Выберите причину</option>';
                        reasons.forEach(function(r) {
                            var opt = document.createElement('option');
                            opt.value = r;
                            opt.textContent = r;
                            reasonSelect.appendChild(opt);
                        });
                        reasonSelect.disabled = false;
                    })
                    .catch(function(e) { console.error(e); });
            } else {
                reasonSelect.innerHTML = '<option value="">Сначала выберите категорию</option>';
                reasonSelect.disabled = true;
            }
        });
    }
})();
</script>

