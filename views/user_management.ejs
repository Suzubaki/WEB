<%- include('layout/header', { title: 'Управление пользователями' }) %>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-people"></i> Управление пользователями</h4>
                <a href="/register" class="btn btn-light btn-sm">
                    <i class="bi bi-person-plus"></i> Добавить нового пользователя
                </a>
            </div>
            <div class="card-body">
                <% if (users && users.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Имя пользователя</th>
                                <th>Тип пользователя</th>
                                <th>Ферма</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(user) { %>
                            <tr>
                                <td><%= user.id %></td>
                                <td><%= user.username %></td>
                                <td>
                                    <% if (user.user_type === 'admin') { %>
                                        <span class="badge bg-danger">Администратор</span>
                                    <% } else { %>
                                        <span class="badge bg-success">Ферма</span>
                                    <% } %>
                                </td>
                                <td><%= user.farm_name || '-' %></td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="/edit_user/<%= user.id %>" class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Изменить
                                        </a>
                                        <% if (user.id !== session.user_id) { %>
                                        <button type="button" 
                                                class="btn btn-outline-danger delete-user-btn"
                                                data-user-id="<%= user.id %>"
                                                data-user-name="<%= user.username %>">
                                            <i class="bi bi-trash"></i> Удалить
                                        </button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle"></i> 
                    <strong>Информация:</strong> 
                    Всего пользователей: <%= users.length %>
                    | Администраторов: <%= users.filter(u => u.user_type === 'admin').length %>
                    | Пользователей ферм: <%= users.filter(u => u.user_type === 'farm').length %>
                </div>
                <% } else { %>
                <div class="text-center py-5">
                    <i class="bi bi-people" style="font-size: 3rem; color: #6c757d;"></i>
                    <h4 class="mt-3">Нет пользователей</h4>
                    <p>В системе еще нет зарегистрированных пользователей.</p>
                    <a href="/register" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Добавить первого пользователя
                    </a>
                </div>
                <% } %>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Важная информация</h5>
            </div>
            <div class="card-body">
                <ul>
                    <li>Администраторы могут управлять всеми пользователями системы</li>
                    <li>Пользователи типа "Ферма" могут просматривать и добавлять данные только своей фермы</li>
                    <li>Вы не можете удалить свою собственную учетную запись</li>
                    <li>При изменении пароля пользователя, оставьте поле пароля пустым, чтобы не изменять его</li>
                    <li>Все изменения вступают в силу немедленно</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<%- include('layout/footer', {
    extra_js: `
    <script>
    $(document).ready(function() {
        $(document).on('click', '.delete-user-btn', function(e) {
            e.preventDefault();
            var userId = $(this).data('user-id');
            var username = $(this).data('user-name');
            
            if (confirm('Вы уверены, что хотите удалить пользователя "' + username + '"?')) {
                var form = $('<form>', {
                    'method': 'POST',
                    'action': '/delete_user/' + userId
                });
                form.appendTo('body').submit();
            }
        });
    });
    </script>
    `
}) %>
