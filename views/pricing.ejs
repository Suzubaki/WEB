<%- include('layout/header', { 
    title: 'Экономика и Нормативы BYN',
    extra_css: `
    <style>
        .methodology-card {
            border-left: 5px solid #2563eb;
            background: #f8fafc;
        }
        .price-input-group .input-group-text {
            background-color: #f1f5f9;
            font-weight: 600;
        }
    </style>`
}) %>

<div class="container-fluid px-4 py-3">
    <!-- Заголовок страницы -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-calculator text-primary"></i> Экономические нормативы и оценка ущерба (BYN)
            </h3>
            <p class="text-muted mb-0">Управление нормативами балансовой стоимости скота, закупочных цен и методологией расчета</p>
        </div>
        <div>
            <a href="/dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Вернуться в дашборд
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Левая колонка: Методология и формулы -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-book me-2"></i> Методика расчета экономического ущерба (РБ)
                    </h5>
                    <span class="badge bg-warning text-dark fw-bold">Инструкция Минсельхозпрода</span>
                </div>
                <div class="card-body">
                    <div class="alert methodology-card p-3 mb-4">
                        <h6 class="fw-bold text-primary mb-2"><i class="bi bi-info-circle-fill"></i> Главное правило финансового учета:</h6>
                        <p class="mb-0 small">
                            Финансовый ущерб сельхозпредприятия от выбытия животного рассчитывается на основе его <strong>балансовой (первоначальной или восстановительной) стоимости в BYN</strong>.
                        </p>
                    </div>

                    <h6 class="fw-bold mb-3"><i class="bi bi-diagram-3 text-primary me-2"></i> Пошаговая схема вычисления:</h6>
                    <ol class="list-group list-group-numbered mb-4">
                        <li class="list-group-item border-0 px-0 py-2">
                            <strong>Индивидуальная точная оценка (Фактическая):</strong>
                            <div class="text-muted small">Если при внесении записи о выбытии коровы в поле <code>Балансовая стоимость</code> указано конкретное число (например, по бухгалтерской справке), в расчет берется <strong>именно эта фактическая сумма</strong>.</div>
                        </li>
                        <li class="list-group-item border-0 px-0 py-2">
                            <strong>Нормативная оценка (При отсутствии заполненого поля):</strong>
                            <div class="text-muted small">Если балансовая стоимость в первичном документе не указана (<code>NULL</code> / 0), система подставляет <strong>действующий норматив оценочной стоимости BYN</strong> для соответствующей половозрастной группы (см. форму справа).</div>
                        </li>
                        <li class="list-group-item border-0 px-0 py-2">
                            <strong>Разделение по категориям выбытия:</strong>
                            <div class="text-muted small">
                                • <strong>Ущерб от падежа (BYN):</strong> Прямой невосполнимый падежный убыток (100% потеря стоимости).<br>
                                • <strong>Ущерб от выбраковки (BYN):</strong> Вынужденная сдача на мясокомбинат или убой с учетом компенсации от реализации мясопродукции.<br>
                                • <strong>Санитарный убой (BYN):</strong> Оценка потерь при санитарной прирезке.
                            </div>
                        </li>
                        <li class="list-group-item border-0 px-0 py-2">
                            <strong>Средние удельные показатели:</strong>
                            <div class="text-muted small"><code>Средний ущерб на 1 гол. = Общий ущерб (BYN) / Всего выбыло голов</code></div>
                        </li>
                    </ol>

                    <div class="card border-info bg-info-subtle p-3">
                        <div class="d-flex gap-2">
                            <i class="bi bi-shield-check text-info fs-4"></i>
                            <div class="small">
                                <strong>Прозрачность расчетов:</strong> Все изменения нормативов цен на этой странице мгновенно пересчитывают аналитический дашборд, графики структуры ущерба и отчетные формы 210-АПК без перезагрузки базы данных.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Правая колонка: Форма редактора цен BYN -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-sliders me-2"></i> Настройка нормативов оценочной стоимости (BYN)
                    </h5>
                    <% if (user_type === 'admin') { %>
                        <span class="badge bg-success"><i class="bi bi-pencil-square"></i> Режим редактирования</span>
                    <% } else { %>
                        <span class="badge bg-secondary"><i class="bi bg-lock"></i> Только просмотр</span>
                    <% } %>
                </div>
                <div class="card-body">
                    <form id="pricingForm">
                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-tag text-primary me-2"></i> 1. Нормативная стоимость по половозрастным группам (BYN/гол.):</h6>
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Телята (0–6 месяцев)</label>
                                <div class="input-group price-input-group">
                                    <input type="number" step="10" min="0" class="form-control" id="price_calves" name="price_calves" value="<%= pricing.price_calves %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">BYN</span>
                                </div>
                                <div class="form-text extra-small">Молодняк на подсосе и доращивании</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Ремонтный молодняк (6–18 мес.)</label>
                                <div class="input-group price-input-group">
                                    <input type="number" step="10" min="0" class="form-control" id="price_youngstock" name="price_youngstock" value="<%= pricing.price_youngstock %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">BYN</span>
                                </div>
                                <div class="form-text extra-small">Телки и бычки на откорме</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Нетели (случной возраст)</label>
                                <div class="input-group price-input-group">
                                    <input type="number" step="10" min="0" class="form-control" id="price_heifers" name="price_heifers" value="<%= pricing.price_heifers %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">BYN</span>
                                </div>
                                <div class="form-text extra-small">Осемененные телки до растела</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Коровы дойного стада</label>
                                <div class="input-group price-input-group">
                                    <input type="number" step="10" min="0" class="form-control" id="price_cows" name="price_cows" value="<%= pricing.price_cows %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">BYN</span>
                                </div>
                                <div class="form-text extra-small">Основное фуражное стадо</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Сухостойные коровы</label>
                                <div class="input-group price-input-group">
                                    <input type="number" step="10" min="0" class="form-control" id="price_dry_cows" name="price_dry_cows" value="<%= pricing.price_dry_cows %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">BYN</span>
                                </div>
                                <div class="form-text extra-small">Сухостой 1-й и 2-й фазы</div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-shield-check text-warning me-2"></i> 3. Зоотехнические нормативы и целевые пороги тревог (Scorecard %):</h6>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Целевая сохранность молодняка</label>
                                <div class="input-group price-input-group">
                                    <span class="input-group-text">≥</span>
                                    <input type="number" step="0.5" min="0" max="100" class="form-control" id="norm_youngstock_preservation" name="norm_youngstock_preservation" value="<%= pricing.norm_youngstock_preservation || 92.0 %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="form-text extra-small">Порог нормы сохранения (до 18 мес)</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Макс. выбытие новотела (0–30 DIM)</label>
                                <div class="input-group price-input-group">
                                    <span class="input-group-text">≤</span>
                                    <input type="number" step="0.5" min="0" max="100" class="form-control" id="norm_fresh_cow_disposal" name="norm_fresh_cow_disposal" value="<%= pricing.norm_fresh_cow_disposal || 10.0 %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="form-text extra-small">Допустимая доля выбытия новотела</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Макс. выбраковка первотёлок</label>
                                <div class="input-group price-input-group">
                                    <span class="input-group-text">≤</span>
                                    <input type="number" step="0.5" min="0" max="100" class="form-control" id="norm_first_lactation_culling" name="norm_first_lactation_culling" value="<%= pricing.norm_first_lactation_culling || 20.0 %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="form-text extra-small">Допустимый предел по 1-й лактации</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Макс. доля падежа (летальность)</label>
                                <div class="input-group price-input-group">
                                    <span class="input-group-text">≤</span>
                                    <input type="number" step="0.5" min="0" max="100" class="form-control" id="norm_mortality_rate" name="norm_mortality_rate" value="<%= pricing.norm_mortality_rate || 25.0 %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="form-text extra-small">Предельная доля падежа в выбытии</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Макс. болезней конечностей/копыт</label>
                                <div class="input-group price-input-group">
                                    <span class="input-group-text">≤</span>
                                    <input type="number" step="0.5" min="0" max="100" class="form-control" id="norm_locomotor_disorders" name="norm_locomotor_disorders" value="<%= pricing.norm_locomotor_disorders || 15.0 %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="form-text extra-small">Порог ортопедических патологий</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Макс. маститов и патологий вымени</label>
                                <div class="input-group price-input-group">
                                    <span class="input-group-text">≤</span>
                                    <input type="number" step="0.5" min="0" max="100" class="form-control" id="norm_mastitis_disorders" name="norm_mastitis_disorders" value="<%= pricing.norm_mastitis_disorders || 15.0 %>" <%= user_type !== 'admin' ? 'disabled' : '' %>>
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="form-text extra-small">Порог заболеваний молочной железы</div>
                            </div>
                        </div>

                        <% if (user_type === 'admin') { %>
                            <div class="d-flex gap-2 justify-content-end mt-4">
                                <button type="button" class="btn btn-outline-secondary" id="resetDefaultsBtn">
                                    <i class="bi bi-arrow-counterclockwise"></i> Сбросить по умолчанию
                                </button>
                                <button type="submit" class="btn btn-success fw-bold px-4" id="savePricingBtn">
                                    <i class="bi bi-check-circle-fill me-1"></i> Сохранить нормативы и пороги
                                </button>
                            </div>
                        <% } else { %>
                            <div class="alert alert-warning py-2 small mb-0">
                                <i class="bi bi-exclamation-triangle-fill"></i> Редактирование нормативных цен и порогов доступно только Главным зоотехникам и Администраторам.
                            </div>
                        <% } %>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('layout/footer', {
    extra_js: `
    <script>
    (function() {
        var pricingForm = document.getElementById('pricingForm');
        var resetBtn = document.getElementById('resetDefaultsBtn');

        if (pricingForm) {
            pricingForm.addEventListener('submit', function(e) {
                e.preventDefault();
                var btn = document.getElementById('savePricingBtn');
                if (btn) btn.disabled = true;

                var data = {
                    price_calves: parseFloat(document.getElementById('price_calves').value) || 900,
                    price_youngstock: parseFloat(document.getElementById('price_youngstock').value) || 1650,
                    price_heifers: parseFloat(document.getElementById('price_heifers').value) || 2700,
                    price_cows: parseFloat(document.getElementById('price_cows').value) || 3200,
                    price_dry_cows: parseFloat(document.getElementById('price_dry_cows').value) || 3000,
                    meat_price_per_kg: parseFloat(document.getElementById('meat_price_per_kg').value) || 6.20,
                    milk_price_per_kg: parseFloat(document.getElementById('milk_price_per_kg').value) || 1.18,
                    replacement_cost: parseFloat(document.getElementById('replacement_cost').value) || 2950,
                    norm_youngstock_preservation: parseFloat(document.getElementById('norm_youngstock_preservation').value) || 92.0,
                    norm_fresh_cow_disposal: parseFloat(document.getElementById('norm_fresh_cow_disposal').value) || 10.0,
                    norm_first_lactation_culling: parseFloat(document.getElementById('norm_first_lactation_culling').value) || 20.0,
                    norm_mortality_rate: parseFloat(document.getElementById('norm_mortality_rate').value) || 25.0,
                    norm_locomotor_disorders: parseFloat(document.getElementById('norm_locomotor_disorders').value) || 15.0,
                    norm_mastitis_disorders: parseFloat(document.getElementById('norm_mastitis_disorders').value) || 15.0
                };

                fetch('/api/pricing', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                })
                .then(function(r) { return r.json(); })
                .then(function(res) {
                    if (btn) btn.disabled = false;
                    if (res.success) {
                        alert('✅ ' + res.message);
                    } else {
                        alert('❌ Ошибка обновления цен и порогов: ' + (res.error || 'Ошибка'));
                    }
                })
                .catch(function(err) {
                    if (btn) btn.disabled = false;
                    console.error(err);
                    alert('❌ Ошибка сети при сохранении цен.');
                });
            });
        }

        if (resetBtn) {
            resetBtn.addEventListener('click', function() {
                if (confirm('Восстановить базовые нормативные цены и пороги тревог Минсельхозпрода РБ по умолчанию?')) {
                    document.getElementById('price_calves').value = 900;
                    document.getElementById('price_youngstock').value = 1650;
                    document.getElementById('price_heifers').value = 2700;
                    document.getElementById('price_cows').value = 3200;
                    document.getElementById('price_dry_cows').value = 3000;
                    document.getElementById('meat_price_per_kg').value = 6.20;
                    document.getElementById('milk_price_per_kg').value = 1.18;
                    document.getElementById('replacement_cost').value = 2950;
                    document.getElementById('norm_youngstock_preservation').value = 92.0;
                    document.getElementById('norm_fresh_cow_disposal').value = 10.0;
                    document.getElementById('norm_first_lactation_culling').value = 20.0;
                    document.getElementById('norm_mortality_rate').value = 25.0;
                    document.getElementById('norm_locomotor_disorders').value = 15.0;
                    document.getElementById('norm_mastitis_disorders').value = 15.0;
                }
            });
        }
    })();
    </script>
    `
}) %>
