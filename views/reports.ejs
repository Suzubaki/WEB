<%- include('layout/header', { title: 'Генерация отчётов' }) %>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-file-earmark-text"></i> Генерация отчётов</h4>
            </div>
            <div class="card-body">
                <form method="POST" action="/generate_report">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="start_date" class="form-label">Начальная дата *</label>
                            <input type="date" class="form-control" id="start_date" name="start_date" required>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="end_date" class="form-label">Конечная дата *</label>
                            <input type="date" class="form-control" id="end_date" name="end_date" required>
                        </div>
                    </div>
                    
                    <% if (user_type === 'admin') { %>
                    <div class="mb-3">
                        <label for="farm_filter" class="form-label">Ферма</label>
                        <select class="form-select" id="farm_filter" name="farm_filter">
                            <option value="all">Все фермы</option>
                            <% (typeof unique_farms !== 'undefined' ? unique_farms : []).forEach(function(f) { %>
                            <option value="<%= f %>"><%= f %></option>
                            <% }); %>
                        </select>
                        <div class="form-text">Выберите "Все фермы" для общего отчёта</div>
                    </div>
                    <% } else { %>
                    <input type="hidden" name="farm_filter" value="<%= session.farm_name %>">
                    <div class="mb-3">
                        <label class="form-label">Ферма</label>
                        <input type="text" class="form-control" value="<%= session.farm_name %>" disabled>
                    </div>
                    <% } %>
                    
                    <div class="mb-3">
                        <label for="report_type" class="form-label">Тип формируемого документа *</label>
                        <select class="form-select" id="report_type" name="report_type" required>
                            <option value="form_209_apk" selected>Акт на выбытие (Форма 209-АПК РБ — падёж, забой, прирезка)</option>
                            <option value="form_210_apk">Акт на выбраковку из основного стада (Форма 210-АПК РБ)</option>
                            <option value="aits_registry">Реестр для ГИС «AITS» (Снятие с государственного учёта)</option>
                            <option value="matrix">Сводная матрица выбытия (МТФ × Причины выбытия)</option>
                            <option value="structured">Структурированный сводный отчёт (Excel)</option>
                            <option value="simple">Простая ведомость данных</option>
                        </select>
                    </div>
                    
                    <div class="mb-3" id="category_field" style="display: none;">
                        <label for="report_category" class="form-label">Категория для матричного отчёта *</label>
                        <select class="form-select" id="report_category" name="report_category">
                            <option value="">Выберите категорию...</option>
                            <option value="падёж">Падёж</option>
                            <option value="выбраковка">Выбраковка</option>
                            <option value="санитарный">Санитарный блок</option>
                        </select>
                        <div class="form-text">Выберите категорию для построения матрицы "фермы × причины"</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="format" class="form-label">Формат отчёта *</label>
                        <select class="form-select" id="format" name="format" required>
                            <option value="">Выберите формат...</option>
                            <option value="excel">Excel (.xlsx)</option>
                            <option value="csv">CSV (.csv)</option>
                            <option value="preview">Предпросмотр в браузере</option>
                        </select>
                    </div>
                    
                    <div class="alert alert-info">
                        <h6><i class="bi bi-info-circle"></i> Информация о типах отчётов:</h6>
                        <ul class="mb-0">
                            <li><strong>Структурированный отчёт</strong> - профессиональный Excel файл со структурой, заголовками и форматированием</li>
                            <li><strong>Простой отчёт</strong> - таблица в Excel или CSV формате</li>
                            <li><strong>Матричный отчёт</strong> - таблица "фермы × причины" с выбранной категорией</li>
                        </ul>
                    </div>
                    
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="/dashboard" class="btn btn-secondary me-2">
                            <i class="bi bi-arrow-left"></i> Назад
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-file-earmark-arrow-down"></i> Сгенерировать отчёт
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Примеры отчётов -->
        <div class="card mt-3">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-card-checklist"></i> Примеры отчётов</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <h6><i class="bi bi-file-earmark-excel text-success"></i> Excel отчёт</h6>
                                <p class="small">Структура Excel файла:</p>
                                <ul class="small">
                                    <li>Заголовки с форматированием</li>
                                    <li>Данные по всем выбранным фермам</li>
                                    <li>Сортировка по дате выбытия</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <h6><i class="bi bi-file-earmark-text text-info"></i> CSV отчёт</h6>
                                <p class="small">Структура CSV файла:</p>
                                <ul class="small">
                                    <li>Простой текстовый формат</li>
                                    <li>Разделители - запятые</li>
                                    <li>Импорт в любые системы</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <% if (user_type === 'admin') { %>
        <!-- Отчёт по официальному шаблону (только для админов) -->
        <div class="card mt-3">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-file-earmark-excel"></i> Отчёт по официальному шаблону</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <h6><i class="bi bi-info-circle"></i> Официальный шаблон</h6>
                    <p class="mb-0">
                        Данные автоматически заполняются в колонку "Пало, гол." как сумма: 
                        <strong>Выбраковка + Санитарный брак + Падёж</strong>.
                    </p>
                </div>
                
                <form method="POST" action="/generate_original_excel">
                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="bi bi-file-earmark-excel-fill"></i> Создать отчёт по официальному шаблону
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <% } %>
    </div>
</div>

<%- include('layout/footer', {
    extra_js: `
    <script>
    $(document).ready(function() {
        function toggleCategoryField() {
            var reportType = $('#report_type').val();
            var categoryField = $('#category_field');
            if (reportType === 'matrix') {
                categoryField.show();
                $('#report_category').prop('required', true);
            } else {
                categoryField.hide();
                $('#report_category').prop('required', false);
            }
        }
        
        toggleCategoryField();
        $('#report_type').change(toggleCategoryField);
        
        var today = new Date();
        var lastMonth = new Date();
        lastMonth.setMonth(lastMonth.getMonth() - 1);
        $('#start_date').val(lastMonth.toISOString().split('T')[0]);
        $('#end_date').val(today.toISOString().split('T')[0]);
    });
    </script>
    `
}) %>
