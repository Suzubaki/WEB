<%- include('layout/header', { title: 'Добавление коров (динамически)' }) %>

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle-dotted"></i> Добавление коров (динамически)</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <h5><i class="bi bi-info-circle"></i> Инструкция</h5>
                    <p>Добавляйте коров по одной. ID коровы будет сгенерирован автоматически в формате: <strong><%= farm_name %>-001</strong></p>
                    <p>Нажмите "Добавить корову" для добавления ещё одной строки.</p>
                    <p><strong>Внимание:</strong> Дата выбытия не может быть позже сегодняшнего дня.</p>
                    <p class="mb-0"><strong>Важно:</strong> Данные автоматически сохраняются в черновик при вводе.</p>
                </div>
                
                <form id="cows-form">
                    <input type="hidden" name="farm_name" value="<%= farm_name %>">
                    
                    <div class="mb-3">
                        <label class="form-label">Ферма</label>
                        <input type="text" class="form-control" value="<%= farm_name %>" disabled>
                        <div class="form-text">ID коров будут сгенерированы для этой фермы</div>
                    </div>
                    
                    <!-- Контейнер для динамически добавляемых коров -->
                    <div id="cows-container"></div>
                    
                    <!-- Кнопка добавления новой коровы -->
                    <div class="text-center mb-4">
                        <button type="button" id="add-cow-btn" class="btn btn-outline-primary">
                            <i class="bi bi-plus-circle"></i> Добавить корову
                        </button>
                    </div>
                    
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="button" id="cancel-btn" class="btn btn-danger me-2">
                            <i class="bi bi-x-circle"></i> Отмена
                        </button>
                        <a href="/dashboard" class="btn btn-secondary me-2">
                            <i class="bi bi-arrow-left"></i> Назад
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Сохранить всех коров
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Категории выбытия</h5>
            </div>
            <div class="card-body">
                <div class="accordion" id="categoriesAccordion">
                    <% let idx = 1; for (const [category, reasons] of Object.entries(categories)) { %>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading<%= idx %>">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                    data-bs-target="#collapse<%= idx %>">
                                <%= category.charAt(0).toUpperCase() + category.slice(1) %>
                            </button>
                        </h2>
                        <div id="collapse<%= idx %>" class="accordion-collapse collapse" 
                             data-bs-parent="#categoriesAccordion">
                            <div class="accordion-body">
                                <ul class="list-group list-group-flush">
                                    <% reasons.forEach(function(reason) { %>
                                    <li class="list-group-item"><%= reason %></li>
                                    <% }); %>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <% idx++; } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Контейнер для toast уведомлений -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1050;"></div>

<!-- Модальное окно подтверждения отмены -->
<div class="modal fade" id="cancelConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Подтверждение отмены</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>У вас есть несохраненные данные. Что вы хотите сделать?</p>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    <small>Черновик автоматически сохраняется при вводе данных.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-left"></i> Вернуться
                </button>
                <button type="button" class="btn btn-success" id="saveDraftBtn">
                    <i class="bi bi-save"></i> Сохранить черновик
                </button>
                <button type="button" class="btn btn-danger" id="confirmCancelBtn">
                    <i class="bi bi-trash"></i> Удалить и выйти
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('layout/footer', {
    extra_js: `
    <script>
    $(document).ready(function() {
        let cowCount = 1;
        let draftData = [];
        
        function createCowRow(index) {
            var today = new Date().toISOString().split('T')[0];
            return \`
                <div class="card cow-row mb-3 shadow-sm border" id="cow-row-\${index}">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                        <span class="fw-bold text-primary">Животное #\${index}</span>
                        <button type="button" class="btn btn-sm btn-outline-danger delete-cow-btn" data-index="\${index}">
                            <i class="bi bi-trash"></i> Удалить
                        </button>
                    </div>
                    <div class="card-body py-3">
                        <div class="row g-2">
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Категория *</label>
                                <select class="form-select form-select-sm category-select" data-index="\${index}" required>
                                    <option value="">Выберите категорию</option>
                                    <option value="падёж">Падёж</option>
                                    <option value="выбраковка">Выбраковка</option>
                                    <option value="санитарный">Санитарный брак</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Причина / Диагноз *</label>
                                <select class="form-select form-select-sm reason-select" id="reason-\${index}" disabled required>
                                    <option value="">Сначала выберите категорию</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Дата выбытия *</label>
                                <input type="date" class="form-control form-control-sm disposal-date" required max="\${today}" value="\${today}">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Идент. № (AITS)</label>
                                <input type="text" class="form-control form-control-sm ear-tag" placeholder="BY 04 1234">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Половозрастная группа (ПВГ)</label>
                                <select class="form-select form-select-sm age-group">
                                    <option value="Коровы дойного стада" selected>Коровы дойного стада</option>
                                    <option value="Коровы сухостойные">Коровы сухостойные</option>
                                    <option value="Нетели">Нетели</option>
                                    <option value="Тёлки старше 1 года">Тёлки старше 1 года</option>
                                    <option value="Телята (0–6 мес.)">Телята (0–6 мес.)</option>
                                    <option value="Молодняк (6–12 мес.)">Молодняк (6–12 мес.)</option>
                                    <option value="Бычки на откорме">Бычки на откорме</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Порода скота</label>
                                <select class="form-select form-select-sm breed-select">
                                    <option value="Черно-пёстрая" selected>Черно-пёстрая</option>
                                    <option value="Голштинская">Голштинская</option>
                                    <option value="Красная белорусская">Красная бел.</option>
                                    <option value="Симментальская">Симментальская</option>
                                    <option value="Лимузин">Лимузин</option>
                                    <option value="Помесь">Помесь</option>
                                </select>
                            </div>
                            <div class="col-md-1">
                                <label class="form-label small fw-semibold">Лактация</label>
                                <input type="number" class="form-control form-control-sm lactation" min="0" max="20" placeholder="№">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Живая масса (кг)</label>
                                <input type="number" step="0.1" class="form-control form-control-sm weight" min="0" placeholder="кг">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Удой за лакт. (кг)</label>
                                <input type="number" step="1" class="form-control form-control-sm milk-yield" min="0" placeholder="кг">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Балансовая ст. (BYN)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm book-value" min="0" placeholder="руб.">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Примечание</label>
                                <input type="text" class="form-control form-control-sm notes" placeholder="Примечание ветеринара...">
                            </div>
                        </div>
                    </div>
                </div>
            \`;
        }
        
        const savedDraft = localStorage.getItem('cows_draft');
        if (savedDraft) {
            try {
                draftData = JSON.parse(savedDraft);
                if (Array.isArray(draftData) && draftData.length > 0) {
                    if (confirm('Обнаружен черновик с данными. Восстановить?')) {
                        cowCount = draftData.length;
                        draftData.forEach((cow, index) => {
                            $('#cows-container').append(createCowRow(index + 1));
                            setTimeout(() => {
                                const $row = $(\`#cow-row-\${index + 1}\`);
                                $row.find('.category-select').val(cow.category).trigger('change');
                                setTimeout(() => {
                                    $row.find('.reason-select').val(cow.reason);
                                    var selectedDate = cow.disposal_date;
                                    var today = new Date().toISOString().split('T')[0];
                                    var dateToSet = selectedDate;
                                    if (selectedDate && selectedDate > today) {
                                        dateToSet = today;
                                        showToast('Дата в черновике была позже сегодняшнего дня. Установлена сегодняшняя дата.', 'warning');
                                    }
                                    $row.find('.disposal-date').val(dateToSet);
                                }, 100);
                            }, 50);
                        });
                    } else {
                        localStorage.removeItem('cows_draft');
                        $('#cows-container').append(createCowRow(cowCount));
                    }
                } else {
                    $('#cows-container').append(createCowRow(cowCount));
                }
            } catch (e) {
                localStorage.removeItem('cows_draft');
                $('#cows-container').append(createCowRow(cowCount));
            }
        } else {
            $('#cows-container').append(createCowRow(cowCount));
        }
        
        $('#add-cow-btn').click(function() {
            cowCount++;
            $('#cows-container').append(createCowRow(cowCount));
            updateCowNumbers();
            saveDraft();
        });
        
        $(document).on('click', '.delete-cow-btn', function() {
            const index = $(this).data('index');
            if ($('.cow-row').length > 1) {
                $(\`#cow-row-\${index}\`).remove();
                updateCowNumbers();
                saveDraft();
            } else {
                alert('Должна остаться хотя бы одна корова');
            }
        });
        
        function updateCowNumbers() {
            $('.cow-row').each(function(index) {
                const newIndex = index + 1;
                $(this).find('h5').text(\`Корова #\${newIndex}\`);
                $(this).attr('id', \`cow-row-\${newIndex}\`);
                $(this).find('.category-select').attr('data-index', newIndex);
                $(this).find('.reason-select').attr('id', \`reason-\${newIndex}\`);
                $(this).find('.delete-cow-btn').attr('data-index', newIndex);
            });
        }
        
        $(document).on('change', '.category-select', function() {
            var category = $(this).val();
            var rowIndex = $(this).data('index');
            
            if (category) {
                $.getJSON('/get_reasons/' + encodeURIComponent(category), function(data) {
                    var $reasonSelect = $('#reason-' + rowIndex);
                    $reasonSelect.empty();
                    $reasonSelect.append('<option value="">Выберите причину</option>');
                    $.each(data, function(index, reason) {
                        $reasonSelect.append('<option value="' + reason + '">' + reason + '</option>');
                    });
                    $reasonSelect.prop('disabled', false);
                });
            }
            saveDraft();
        });
        
        $(document).on('change', '.disposal-date', function() {
            var selectedDate = $(this).val();
            var today = new Date().toISOString().split('T')[0];
            
            if (selectedDate > today) {
                $(this).addClass('is-invalid');
                $(this).siblings('.date-error').show();
            } else {
                $(this).removeClass('is-invalid');
                $(this).siblings('.date-error').hide();
            }
            saveDraft();
        });
        
        $(document).on('change', '.reason-select', function() {
            saveDraft();
        });
        
        function saveDraft() {
            const cowsData = [];
            let today = new Date().toISOString().split('T')[0];
            
            $('.cow-row').each(function() {
                var category = $(this).find('.category-select').val();
                var reason = $(this).find('.reason-select').val();
                var disposalDate = $(this).find('.disposal-date').val();
                
                var dateToSave = disposalDate;
                if (disposalDate && disposalDate > today) {
                    dateToSave = today;
                }
                
                if (category || reason || dateToSave) {
                    cowsData.push({
                        category: category || '',
                        reason: reason || '',
                        disposal_date: dateToSave || ''
                    });
                }
            });
            
            if (cowsData.length > 0) {
                localStorage.setItem('cows_draft', JSON.stringify(cowsData));
            }
        }
        
        $('#cows-form').submit(function(e) {
            e.preventDefault();
            
            var cowsData = [];
            var isValid = true;
            var today = new Date().toISOString().split('T')[0];
            
            $('.cow-row').each(function() {
                var category = $(this).find('.category-select').val();
                var reason = $(this).find('.reason-select').val();
                var disposalDate = $(this).find('.disposal-date').val();
                
                if (!category || !reason || !disposalDate) {
                    isValid = false;
                    $(this).addClass('border-danger');
                    return;
                }
                
                if (disposalDate > today) {
                    isValid = false;
                    $(this).addClass('border-danger');
                    $(this).find('.disposal-date').addClass('is-invalid');
                    $(this).find('.date-error').show();
                    alert('Дата выбытия не может быть позже сегодняшнего дня');
                    return;
                }
                
                $(this).removeClass('border-danger');
                $(this).find('.disposal-date').removeClass('is-invalid');
                $(this).find('.date-error').hide();
                
                cowsData.push({
                    category: category,
                    reason: reason,
                    disposal_date: disposalDate,
                    ear_tag: $(this).find('.ear-tag').val().trim() || null,
                    breed: $(this).find('.breed-select').val() || 'Черно-пёстрая',
                    age_group: $(this).find('.age-group').val() || 'Коровы дойного стада',
                    lactation: $(this).find('.lactation').val() || null,
                    weight: $(this).find('.weight').val() || null,
                    milk_yield: $(this).find('.milk-yield').val() || null,
                    book_value: $(this).find('.book-value').val() || null,
                    notes: $(this).find('.notes').val().trim() || null
                });
            });
            
            if (!isValid) {
                alert('Заполните все обязательные поля для всех коров и проверьте даты');
                return;
            }
            
            localStorage.removeItem('cows_draft');
            
            if (confirm(\`Сохранить \${cowsData.length} коров?\`)) {
                $.ajax({
                    url: '/add_multiple_cows',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ cows_data: cowsData }),
                    success: function(response) {
                        window.location.href = '/cows';
                    },
                    error: function(xhr, status, error) {
                        alert('Ошибка при сохранении данных: ' + error);
                        saveDraft();
                    }
                });
            } else {
                saveDraft();
            }
        });
        
        $('#cancel-btn').click(function() {
            const hasData = $('.cow-row').filter(function() {
                return $(this).find('.category-select').val() || 
                       $(this).find('.reason-select').val() || 
                       $(this).find('.disposal-date').val();
            }).length > 0;
            
            if (hasData) {
                $('#cancelConfirmModal').modal('show');
            } else {
                localStorage.removeItem('cows_draft');
                window.location.href = '/dashboard';
            }
        });
        
        $('#confirmCancelBtn').click(function() {
            localStorage.removeItem('cows_draft');
            window.location.href = '/dashboard';
        });
        
        $('#saveDraftBtn').click(function() {
            saveDraft();
            $('#cancelConfirmModal').modal('hide');
            showToast('Черновик сохранен. Вы можете вернуться позже.', 'success');
        });
        
        function showToast(message, type = 'info') {
            const toastId = 'toast-' + Date.now();
            const icon = type === 'success' ? 'bi-check-circle' : 'bi-info-circle';
            const bgColor = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-info';
            
            const toastHtml = \`
                <div id="\${toastId}" class="toast align-items-center \${bgColor} text-white border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi \${icon} me-2"></i> \${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            \`;
            
            $('.toast-container').append(toastHtml);
            const toastEl = $('#' + toastId);
            const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
            toast.show();
            toastEl.on('hidden.bs.toast', function() { $(this).remove(); });
        }
    });
    </script>
    `
}) %>
